---
// Global interactive Instagram Reel Video Modal Component
---

<div 
  id="instagram-video-modal" 
  class="fixed inset-0 z-[100] hidden items-center justify-center p-3 sm:p-6 bg-black/85 backdrop-blur-xl transition-all duration-300 opacity-0 pointer-events-none overscroll-contain transform-gpu"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-reel-title"
>
  <!-- Background Dismiss Backdrop -->
  <div class="modal-backdrop absolute inset-0 cursor-pointer" aria-label="Close video player"></div>

  <!-- Modal Dialog Container -->
  <div class="relative z-10 w-full max-w-[440px] max-h-[92dvh] flex flex-col bg-[#111317] border border-white/15 rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.85)] overflow-hidden transform scale-95 transition-transform duration-300">
    
    <!-- Modal Header -->
    <div class="p-4 bg-[#181a20]/90 border-b border-white/10 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2 overflow-hidden">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse flex-shrink-0"></span>
        <span id="modal-reel-category" class="text-[11px] font-bold uppercase tracking-widest text-primary flex-shrink-0">
          Studio Reel
        </span>
        <span class="text-white/30 text-xs flex-shrink-0">•</span>
        <h3 id="modal-reel-title" class="text-xs sm:text-sm font-semibold text-white truncate">
          LivArt Transformation
        </h3>
      </div>
      
      <button 
        type="button" 
        class="modal-close-btn w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors flex-shrink-0"
        aria-label="Close modal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <!-- Video Embed Area (Aspect ratio calibrated for Reels) -->
    <div class="relative w-full aspect-[9/15] bg-black overflow-hidden flex items-center justify-center">
      <!-- Loading Skeleton Indicator -->
      <div id="modal-loader" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-[#0d0e12] z-0">
        <div class="w-10 h-10 border-3 border-primary border-t-transparent rounded-full animate-spin"></div>
        <span class="text-xs text-white/60 tracking-wider uppercase font-semibold">Loading Live Reel...</span>
      </div>

      <!-- Live Instagram Embed iframe -->
      <iframe 
        id="modal-reel-iframe"
        src="" 
        class="relative z-10 w-full h-full border-0 bg-transparent"
        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
        allowfullscreen
        title="Instagram Video Player"
      ></iframe>
    </div>

    <!-- Modal Footer Actions -->
    <div class="p-3.5 bg-[#14161b] border-t border-white/10 flex items-center justify-between gap-2">
      <a 
        id="modal-direct-ig-link"
        href="https://www.instagram.com/livart_academy/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-white text-xs font-semibold tracking-wider transition-colors border border-white/10"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        <span>Open in IG</span>
      </a>

      <a 
        id="modal-whatsapp-inquire-btn"
        href="https://wa.me/919633211151" 
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary hover:bg-[#d40002] text-white text-xs font-bold tracking-wider uppercase transition-all shadow-md flex-1 justify-center"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <span>Ask About This Course</span>
      </a>
    </div>

  </div>
</div>

<script>
  function setupVideoModal() {
    const modal = document.getElementById('instagram-video-modal');
    if (!modal) return;

    const iframe = document.getElementById('modal-reel-iframe') as HTMLIFrameElement;
    const loader = document.getElementById('modal-loader');
    const titleEl = document.getElementById('modal-reel-title');
    const catEl = document.getElementById('modal-reel-category');
    const directLink = document.getElementById('modal-direct-ig-link') as HTMLAnchorElement;
    const whatsappBtn = document.getElementById('modal-whatsapp-inquire-btn') as HTMLAnchorElement;

    function openModal(rawUrl: string, title: string, category: string) {
      if (!modal || !iframe) return;

      // Normalize Instagram URL into embed URL
      // E.g. https://www.instagram.com/livart_academy/reel/DcIgaKVBb3R/ -> https://www.instagram.com/reel/DcIgaKVBb3R/embed/
      const match = rawUrl.match(/(?:reel|p)\/([A-Za-z0-9_-]+)/);
      const code = match ? match[1] : '';
      const embedUrl = code ? `https://www.instagram.com/reel/${code}/embed/` : rawUrl;

      if (titleEl) titleEl.textContent = title || 'LivArt Transformation';
      if (catEl) catEl.textContent = category || 'Studio Reel';
      if (directLink) directLink.href = rawUrl;
      if (whatsappBtn) {
        const msg = encodeURIComponent(`Hi LivArt Academy! I watched your student video "${title}" on your website and would like information regarding the course and upcoming batch.`);
        whatsappBtn.href = `https://wa.me/919633211151?text=${msg}`;
      }

      if (loader) loader.style.display = 'flex';
      iframe.src = embedUrl;

      iframe.onload = () => {
        if (loader) loader.style.display = 'none';
      };

      // Show modal
      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
        const container = modal.querySelector('div.relative.z-10');
        if (container) {
          container.classList.remove('scale-95');
          container.classList.add('scale-100');
        }
      });

      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal || !iframe) return;

      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      const container = modal.querySelector('div.relative.z-10');
      if (container) {
        container.classList.remove('scale-100');
        container.classList.add('scale-95');
      }

      setTimeout(() => {
        modal.classList.add('hidden');
        iframe.src = ''; // Stop audio/video
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }, 250);
    }

    // Attach click listeners to all open-reel-modal triggers
    document.querySelectorAll('[data-reel-url]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const url = el.getAttribute('data-reel-url') || '';
        const title = el.getAttribute('data-reel-title') || '';
        const category = el.getAttribute('data-reel-category') || '';
        if (url) openModal(url, title, category);
      });
    });

    // Close handlers
    modal.querySelectorAll('.modal-close-btn, .modal-backdrop').forEach(btn => {
      btn.addEventListener('click', closeModal);
    });

    // Keyboard ESC to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Expose global helper
    (window as any).openLivartReel = openModal;
  }

  // Run on initial load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupVideoModal);
  } else {
    setupVideoModal();
  }
  document.addEventListener('astro:page-load', setupVideoModal);
</script>
