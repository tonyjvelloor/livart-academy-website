---
interface Props {
  isMalayalam?: boolean;
}

const { isMalayalam = false } = Astro.props;
---

<!-- MOBILE STICKY BOTTOM ACTION BAR (Visible on mobile/tablet screens only) -->
<nav 
  aria-label="Quick Admissions Actions" 
  class="fixed bottom-0 inset-x-0 z-40 bg-[#0a0b0f]/95 backdrop-blur-2xl border-t border-white/15 px-2.5 pt-2 mobile-sticky-action-bar shadow-[0_-8px_30px_rgba(0,0,0,0.85)] lg:hidden print:hidden"
>
  <div class="max-w-md mx-auto grid grid-cols-3 gap-2 items-center">
    
    <!-- 1. Direct Call Helpline -->
    <a 
      href="tel:+919633211151" 
      class="flex flex-col items-center justify-center py-2 px-1 rounded-xl bg-surface-container-high border border-white/10 active:scale-95 transition-all text-white min-h-[48px]"
      aria-label="Call Admissions Helpline"
    >
      <div class="flex items-center gap-1">
        <span class="material-symbols-outlined text-[19px] text-primary">call</span>
        <span class="text-[12px] font-bold tracking-tight">{isMalayalam ? "വിളിക്കൂ" : "Call Desk"}</span>
      </div>
      <span class="text-[9px] text-white/60 tracking-wider font-medium">96332 11151</span>
    </a>

    <!-- 2. WhatsApp Direct Advisor -->
    <a 
      href="https://wa.me/919633211151?text=Hi%20LivArt%20Academy!%20I%20would%20like%20to%20know%20more%20about%20your%20courses%20and%20upcoming%20batch%20admissions." 
      target="_blank" 
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center py-2 px-1 rounded-xl bg-[#25D366] text-white shadow-[0_2px_12px_rgba(37,211,102,0.35)] active:scale-95 transition-all min-h-[48px]"
      aria-label="Chat with Admissions Counselor on WhatsApp"
    >
      <div class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span class="text-[12px] font-bold tracking-tight">{isMalayalam ? "വാട്ട്‌സ്ആപ്പ്" : "WhatsApp"}</span>
      </div>
      <span class="text-[9px] text-white/90 tracking-wider font-semibold uppercase">{isMalayalam ? "തൽക്ഷണം മറുപടി" : "Instant Reply"}</span>
    </a>

    <!-- 3. Syllabus & Apply CTA -->
    <a 
      id="mobile-sticky-apply-link"
      href={isMalayalam ? "/ml/contact-us/" : "/contact-us/"} 
      class="flex flex-col items-center justify-center py-2 px-1 rounded-xl bg-primary hover:bg-[#d40002] text-white shadow-[0_2px_15px_rgba(254,0,2,0.45)] active:scale-95 transition-all min-h-[48px]"
      aria-label="Request Syllabus or Apply"
    >
      <div class="flex items-center gap-1">
        <span class="material-symbols-outlined text-[19px]">download</span>
        <span class="text-[12px] font-bold tracking-tight">{isMalayalam ? "സിലബസ്" : "Syllabus"}</span>
      </div>
      <span class="text-[9px] text-white/90 tracking-wider font-semibold uppercase">{isMalayalam ? "ഫീസ് വിവരങ്ങൾ" : "& Fee Details"}</span>
    </a>

  </div>
</nav>

<script>
  function setupStickyApplyBtn() {
    const applyLink = document.getElementById('mobile-sticky-apply-link');
    if (!applyLink) return;

    const enrollSection = document.getElementById('enroll');
    if (enrollSection) {
      applyLink.addEventListener('click', (e) => {
        e.preventDefault();
        enrollSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        
        // Focus first input if present
        const firstInput = enrollSection.querySelector('input');
        if (firstInput) {
          setTimeout(() => firstInput.focus(), 600);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupStickyApplyBtn);
  } else {
    setupStickyApplyBtn();
  }
  document.addEventListener('astro:page-load', setupStickyApplyBtn);
</script>
