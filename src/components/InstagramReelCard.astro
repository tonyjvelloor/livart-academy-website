---
interface Props {
  url: string;
  image: string;
  category: string;
  title: string;
  description?: string;
  badge?: string;
}

const {
  url,
  image,
  category,
  title,
  description,
  badge = "Watch Reel"
} = Astro.props;
---

<div 
  class="relative group aspect-[9/14] sm:aspect-[3/4] bg-[#131418] rounded-2xl overflow-hidden border border-white/10 shadow-xl flex flex-col justify-end transition-all duration-500 hover:border-primary/60 hover:shadow-[0_12px_40px_rgba(254,0,2,0.3)] cursor-pointer open-reel-modal"
  data-reel-url={url}
  data-reel-title={title}
  data-reel-category={category}
  role="button"
  tabindex="0"
  aria-label={`${title} - Play Reel on website`}
>
  <!-- Poster Image -->
  <img 
    src={image} 
    alt={title} 
    loading="lazy" 
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover filter brightness-[0.78] group-hover:scale-108 group-hover:brightness-95 transition-all duration-700"
  />

  <!-- Ambient Dark Gradient -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-black/20 pointer-events-none"></div>

  <!-- Central Play Icon with Pulse -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-16 h-16 rounded-full bg-primary/90 text-white flex items-center justify-center shadow-[0_0_30px_rgba(254,0,2,0.8)] transform group-hover:scale-115 group-hover:bg-primary transition-all duration-300">
      <span class="material-symbols-outlined text-4xl ml-1">play_arrow</span>
    </div>
  </div>

  <!-- Top Badges -->
  <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between z-10 pointer-events-none">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/70 backdrop-blur-md border border-white/15 text-[10px] font-bold uppercase tracking-wider text-primary shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
      {category}
    </span>
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/70 backdrop-blur-md text-[10px] font-semibold text-white/95 border border-white/10">
      <span class="material-symbols-outlined text-xs text-primary">videocam</span>
      {badge}
    </span>
  </div>

  <!-- Bottom Details -->
  <div class="relative z-10 p-5 space-y-2 pointer-events-none">
    <h4 class="font-headline-sm text-base sm:text-lg font-bold text-white group-hover:text-primary transition-colors leading-snug drop-shadow-md">
      {title}
    </h4>
    {description && (
      <p class="font-body-sm text-xs text-white/80 line-clamp-2 leading-relaxed">
        {description}
      </p>
    )}
    <div class="pt-1 flex items-center justify-between">
      <div class="flex items-center gap-1.5 text-xs text-primary font-bold uppercase tracking-wider">
        <span class="material-symbols-outlined text-sm">smart_display</span>
        <span>Click to Play Here</span>
      </div>
      <span class="text-[11px] text-white/60 group-hover:text-white transition-colors">
        Live Reel &rarr;
      </span>
    </div>
  </div>

  <!-- Invisible Trigger Overlay -->
  <button 
    type="button"
    class="absolute inset-0 w-full h-full z-20 opacity-0 cursor-pointer"
    aria-label={`${title} - Play Video`}
  ></button>
</div>

