---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Livart Academy Blog | Insights on Beauty & Careers">
  <section class="py-space-xl px-margin-sm lg:px-margin-lg max-w-[1000px] mx-auto mt-8 min-h-[60vh]">
    <div class="mb-space-xl text-center">
      <span class="font-label-sm text-label-sm uppercase tracking-[0.2em] text-primary font-semibold block mb-4">Insights & News</span>
      <h1 class="font-display-xl text-display-xl text-on-surface tracking-tight mb-space-md">The Beauty Archive.</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
        Expert guidance on cosmetology careers, bridal makeup trends, and aesthetic clinical practices.
      </p>
    </div>
    <div class="mt-space-xl text-center border border-outline-variant/30 p-space-xl rounded-xl">
      <h2 class="font-headline-md text-on-surface mb-2">Blog coming soon to the new platform</h2>
      <p class="font-body-md text-on-surface-variant">We are migrating our 26+ articles to this new architecture. All previous URLs have been preserved with automatic redirects to protect SEO rankings.</p>
    </div>
  </section>
</Layout>
