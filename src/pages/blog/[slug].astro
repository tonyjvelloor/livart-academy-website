---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Clean title
const cleanTitle = entry.data.title.split('|')[0].trim();

// JSON-LD BlogPosting Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://livart.co.in/blog/${entry.id}/`
  },
  "headline": cleanTitle,
  "description": entry.data.description,
  "image": entry.data.image ? `https://livart.co.in${entry.data.image}` : "https://livart.co.in/images/academy-live/bridal_makeup_live_session.jpg",
  "author": {
    "@type": "Person",
    "name": entry.data.author || "Stephy Sebastian",
    "jobTitle": "Master Educator & Founder",
    "worksFor": {
      "@type": "EducationalOrganization",
      "name": "LivArt Beauty Academy",
      "url": "https://livart.co.in"
    }
  },
  "publisher": {
    "@type": "EducationalOrganization",
    "name": "LivArt Beauty Academy",
    "url": "https://livart.co.in",
    "logo": {
      "@type": "ImageObject",
      "url": "https://livart.co.in/apple-touch-icon.png"
    }
  },
  "datePublished": entry.data.pubDate ? new Date(entry.data.pubDate).toISOString() : "2026-09-01T00:00:00+05:30",
  "dateModified": new Date().toISOString(),
  "articleSection": entry.data.category || "Cosmetology",
  "inLanguage": "en-IN"
};
---

<Layout 
  title={entry.data.title} 
  description={entry.data.description}
  image={entry.data.image}
  schema={articleSchema}
>
  <main class="min-h-screen bg-background text-on-surface">
    <!-- Breadcrumb & Top Bar -->
    <div class="pt-24 sm:pt-28 pb-6 px-margin-sm lg:px-margin-lg max-w-[900px] mx-auto">
      <nav class="flex items-center gap-2 text-xs font-label-sm text-on-surface-variant mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="text-white/30">/</span>
        <a href="/blog/" class="hover:text-primary transition-colors">Blog</a>
        <span class="text-white/30">/</span>
        <span class="text-primary truncate max-w-[200px] sm:max-w-none">{entry.data.category}</span>
      </nav>

      <!-- Category & Read Time -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="px-3 py-1 rounded-full bg-primary/10 border border-primary/25 text-primary text-xs font-bold uppercase tracking-wider">
          {entry.data.category}
        </span>
        <span class="text-xs text-on-surface-variant">
          {entry.data.pubDate ? new Date(entry.data.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'Editorial Staff'}
        </span>
        <span class="text-white/20">•</span>
        <span class="text-xs text-on-surface-variant">
          {entry.data.readTime}
        </span>
      </div>

      <!-- Article Title -->
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-on-surface leading-tight mb-6">
        {cleanTitle}
      </h1>

      <!-- Author Byline -->
      <div class="flex items-center justify-between pb-8 border-b border-white/10">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-primary/20 border border-primary/40 flex items-center justify-center text-primary font-bold text-sm">
            SS
          </div>
          <div>
            <p class="text-sm font-semibold text-on-surface">{entry.data.author}</p>
            <p class="text-xs text-on-surface-variant">Founder & Master Educator • LivArt Academy Kochi</p>
          </div>
        </div>

        <a 
          href="/blog/" 
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-primary-fixed uppercase tracking-wider"
        >
          &larr; Back to Directory
        </a>
      </div>
    </div>

    <!-- Featured Header Image -->
    {entry.data.image && (
      <div class="px-margin-sm lg:px-margin-lg max-w-[900px] mx-auto mb-10">
        <div class="relative aspect-[16/9] rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-surface-container">
          <img 
            src={entry.data.image} 
            alt={cleanTitle}
            class="w-full h-full object-cover"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
        </div>
      </div>
    )}

    <!-- Article Content -->
    <article class="px-margin-sm lg:px-margin-lg max-w-[900px] mx-auto pb-16">
      <div class="prose prose-invert prose-p:text-on-surface-variant prose-p:leading-relaxed prose-p:text-base sm:prose-p:text-lg prose-headings:font-display prose-headings:text-on-surface prose-headings:tracking-tight prose-a:text-primary hover:prose-a:underline prose-li:text-on-surface-variant prose-strong:text-white max-w-none">
        <Content />
      </div>

      <!-- Academy Course Bridge Banner -->
      <div class="mt-16 p-8 rounded-2xl bg-gradient-to-br from-surface-container-high to-surface-container border border-primary/20 shadow-xl">
        <div class="max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-widest text-primary block mb-2">
            Professional Certification & Training
          </span>
          <h3 class="font-display text-2xl font-bold text-on-surface mb-3">
            Want to Master These Skills Professionally?
          </h3>
          <p class="text-sm text-on-surface-variant leading-relaxed mb-6">
            LivArt Beauty Academy in Kalamassery, Kochi provides government-recognized (B&WSSC) master diplomas in Cosmetology, 4K HD Bridal Makeup, Clinical Skin Therapy, and Salon Hair Architecture. Benefit from 1-on-1 mentorship, international products, and 100% placement assurance.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a 
              href="https://wa.me/919633211151?text=Hi%20LivArt%20Academy%2C%20I%20read%20your%20article%20on%20" 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-6 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-md flex items-center gap-2"
            >
              <span>Speak to Academic Advisor</span>
            </a>

            <a 
              href="tel:+919633211151"
              class="px-6 py-2.5 rounded-full bg-primary hover:bg-primary-fixed text-white font-bold text-xs uppercase tracking-wider transition-all shadow-md"
            >
              Call +91 96332 11151
            </a>

            <a 
              href="/overview/"
              class="px-6 py-2.5 rounded-full bg-surface-container border border-white/20 text-on-surface hover:bg-white/10 font-bold text-xs uppercase tracking-wider transition-all"
            >
              View Diploma Courses
            </a>
          </div>
        </div>
      </div>

      <!-- Navigation & Sharing Footer -->
      <div class="mt-12 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a 
          href="/blog/" 
          class="inline-flex items-center gap-2 text-xs font-bold text-primary hover:text-primary-fixed uppercase tracking-wider"
        >
          &larr; Return to All Articles
        </a>

        <div class="text-xs text-on-surface-variant">
          Published by <strong class="text-on-surface">LivArt Beauty Academy</strong> • Kochi, Kerala
        </div>
      </div>
    </article>
  </main>
</Layout>