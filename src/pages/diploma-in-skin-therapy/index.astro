---
import Layout from '../../layouts/Layout.astro';
import CourseLeadForm from '../../components/CourseLeadForm.astro';
import CoursePrintButton from '../../components/CoursePrintButton.astro';
import CoursePrintProspectus from '../../components/CoursePrintProspectus.astro';

const modules = [
  { num: "01", title: "Introduction & Skin Science", desc: "Introduction to skin therapy • Anatomy & physiology of skin • Functions of skin • Skin types & conditions." },
  { num: "02", title: "Client Care & Practice", desc: "Client consultation • Professional ethics • Personal hygiene & grooming • Product knowledge & selection • Trolley & bed preparation • Client draping." },
  { num: "03", title: "Basic Treatments", desc: "Clean up • Bleach & de-tan • Basic facial • Mask & pack." },
  { num: "04", title: "Advanced Treatments", desc: "High frequency, galvanic & ultrasonic facial • Chemical exfoliation • Hydra facial • Anti-aging & rejuvenating facial." },
  { num: "05", title: "Manicure", desc: "Classic manicure • Spa manicure • French manicure." },
  { num: "06", title: "Waxing", desc: "Basic to advanced waxing." },
  { num: "07", title: "Pedicure", desc: "Basic to advanced pedicure." },
  { num: "08", title: "Threading", desc: "Precision facial and eyebrow threading." }
];
---

<Layout 
  title="Diploma in Skin Therapy (4 Months) | Livart Beauty Academy Kochi"
  description="Master clinical skin therapies, Hydra facials, chemical peels, and electrotherapy in this 4-month Diploma in Skin Therapy at Livart Beauty Academy Kochi. Tool kit included."
>
  <div class="screen-only">
  <section class="relative pt-24 pb-16 px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto border-b border-outline-variant/20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter-lg items-center">
      <div>
        <div class="inline-flex items-center gap-space-xs px-3 py-1 rounded-full bg-primary/10 border border-primary/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="font-label-sm uppercase tracking-widest text-primary text-xs font-bold">4-Month Clinical Skin Track</span>
        </div>
        <h1 class="font-display-lg text-display-lg lg:text-[60px] lg:leading-[68px] text-on-surface tracking-tight mb-6">
          Diploma in <span class="italic text-primary">Skin Therapy.</span>
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl leading-relaxed mb-8">
          The definitive four-month clinical aesthetics curriculum. Learn anatomy, electrotherapy (High Frequency, Galvanic, Ultrasonic), chemical peels, Hydra facials, manicure, pedicure, and waxing.
        </p>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8 border-y border-outline-variant/20 py-6">
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Duration</span>
            <strong class="font-title-md text-on-surface text-base">4 Months</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Aesthetic Machines</span>
            <strong class="font-title-md text-on-surface text-base">Hydra & Galvanic</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Tool Kit</span>
            <strong class="font-title-md text-on-surface text-base">Full Kit Included</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Certification</span>
            <strong class="font-title-md text-on-surface text-base">B&WSSC Affiliated</strong>
          </div>
        </div>

        <div class="flex flex-wrap gap-4 items-center">
          <a href="#enroll" class="px-8 py-4 bg-primary text-on-primary font-label-md uppercase tracking-widest font-bold rounded shadow-lg hover:bg-primary-fixed transition-colors flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">download</span>
            Get Syllabus & Fee Details
          </a>
          <CoursePrintButton label="Print Course Details" />
        </div>
      </div>
      
      <div class="relative h-[480px] lg:h-[520px] rounded-2xl overflow-hidden bg-surface-container shadow-2xl">
        <img fetchpriority="high" decoding="async" src="/images/academy-live/hair_makeup_skin_foundation.jpg" class="w-full h-full object-cover" alt="LivArt Skin Therapy Practical Training in Kochi" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-8">
          <div class="inline-block px-3 py-1 bg-primary text-white text-xs uppercase tracking-widest font-bold rounded mb-2 w-max">
            Included in Course
          </div>
          <h3 class="font-headline-sm text-white text-xl font-bold">Skin Therapist Tool Kit</h3>
          <p class="text-white/80 font-body-sm text-sm mt-1">Extractor • Facial Brush • Threading Thread • Professional Facial Kit</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 MODULES -->
  <section class="py-space-xl bg-surface-container-lowest border-b border-outline-variant/20">
    <div class="max-w-[1440px] mx-auto px-margin-sm lg:px-margin-lg">
      <div class="max-w-3xl mb-space-xl">
        <span class="font-label-sm uppercase tracking-widest text-primary block mb-2 font-bold">Complete 8-Module Syllabus</span>
        <h2 class="font-display-lg text-display-lg text-on-surface tracking-tight">Modules of Diploma in Skin Therapy.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {modules.map(m => (
          <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/15 flex flex-col justify-between">
            <div>
              <span class="font-label-sm text-primary uppercase tracking-widest font-bold text-xs block mb-1">Module {m.num}</span>
              <h3 class="font-headline-sm text-lg font-bold text-on-surface mb-2">{m.title}</h3>
              <p class="font-body-sm text-on-surface-variant text-xs leading-relaxed">{m.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LEAD CAPTURE -->
  <section id="enroll" class="py-space-xl px-margin-sm lg:px-margin-lg max-w-[900px] mx-auto scroll-mt-20">
    <CourseLeadForm 
      courseName="Diploma in Skin Therapy (4 Months)"
      title="Request Skin Therapy Syllabus & Fee Structure"
      subtitle="Fill in your details below to receive the complete 4-Month Skin Therapy syllabus, machine training details, toolkit breakdown, and current fee schedule directly on WhatsApp."
      formId="skin-therapy-lead-form"
    />
  </section>
  </div> <!-- /screen-only -->

  <!-- EXECUTIVE PRINT PROSPECTUS (VISIBLE ONLY WHEN PRINTED / SAVED AS PDF) -->
  <CoursePrintProspectus
    courseTitle="Diploma in Skin Therapy (4 Months Clinical Track)"
    courseSubtitle="Advanced clinical aesthetics curriculum covering skin anatomy, electrotherapy (Hydra Facial, High Frequency, Galvanic, Ultrasonic), chemical peels, medical hygiene, and salon spa treatments."
    duration="4 Months (Clinical Aesthetics Track)"
    eligibility="10th / 12th / Any Degree • No Prior Experience Required"
    certification="B&WSSC (Govt of India) Certified • LivArt Diploma in Skin Therapy"
    toolKit="Complete Skin Therapist Tool Kit Included (Professional Facial Kit, Extractor, Brushes, Thread)"
    trainingFormat="100% Practical Training on Clinical Aesthetic Machines and Live Clients in Kalamassery Bays"
    batchCapacity="Strictly 8–10 Students per Batch for Focused Individual Mentorship"
    internship="Live Salon Floor Practical Assessments & 100% Placement Support"
    modules={modules}
    careerOutcomes={[
      "Certified Clinical Skin Therapist & Aesthetician",
      "Hydra Facial & Electrotherapy Specialist",
      "Medi-Spa & Luxury Salon Aesthetician",
      "Independent Skin Care & Beauty Clinic Entrepreneur"
    ]}
  />

  <!-- SCHEMA -->
  <script type="application/ld+json" set:html={`
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "Diploma in Skin Therapy (4 Months)",
      "description": "4-month clinical skin therapy diploma in Kochi covering anatomy, Hydra facials, High frequency, chemical exfoliation, and professional tool kits at Livart Beauty Academy.",
      "provider": {
        "@type": "EducationalOrganization",
        "name": "Livart Beauty Academy",
        "url": "https://livart.co.in"
      }
    }
  `} />
</Layout>
