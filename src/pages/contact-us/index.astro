---
import Layout from '../../layouts/Layout.astro';
import CourseLeadForm from '../../components/CourseLeadForm.astro';
---

<Layout 
  title="Admissions & Contact Us | Livart Beauty Academy Kochi"
  description="Connect with Livart Beauty Academy admissions in Kalamassery, Kochi. Talk to our course counselors, request fee schedules, or schedule a campus tour."
>
  <section class="py-space-xl px-margin-sm lg:px-margin-lg max-w-[1200px] mx-auto mt-8">
    <div class="mb-space-xl text-center">
      <span class="font-label-sm text-label-sm uppercase tracking-[0.2em] text-primary font-semibold block mb-4">Admissions & Counseling Desk</span>
      <h1 class="font-display-xl text-display-xl text-on-surface tracking-tight mb-space-md">Connect with LivArt.</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
        Speak directly with our academic counselors, inquire about upcoming batches, or request the detailed fee structure via WhatsApp.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-start">
      <!-- Contact Info & Campus Details -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-surface-container-low p-6 sm:p-8 rounded-2xl border border-outline-variant/15 shadow-lg">
          <h2 class="font-headline-sm text-2xl font-bold text-on-surface mb-6">Flagship Campus</h2>
          
          <div class="space-y-5 font-body-md text-on-surface-variant text-sm">
            <div class="flex items-start gap-3.5">
              <span class="material-symbols-outlined text-primary text-xl mt-0.5">location_on</span>
              <div>
                <strong class="text-on-surface block text-base font-bold mb-0.5">Kalamassery, Kochi</strong>
                <p class="text-on-surface-variant leading-relaxed">Madukappilly Tower, Pathadipalam, Edappally P.O, Kalamassery, Kochi, Kerala 682024</p>
                <p class="text-xs text-outline mt-1">2 mins walk from Pathadipalam Metro Pillar 384</p>
                <div class="mt-2">
                  <a href="https://share.google/OCj5l70Grn7Wxu8WR" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-primary font-bold hover:underline">
                    <span class="material-symbols-outlined text-sm">open_in_new</span>
                    View Google Business Profile & Directions &rarr;
                  </a>
                </div>
              </div>
            </div>

            <div class="flex items-start gap-3.5">
              <span class="material-symbols-outlined text-primary text-xl mt-0.5">call</span>
              <div>
                <strong class="text-on-surface block text-base font-bold mb-0.5">Admissions Helpline</strong>
                <a href="tel:+919633211151" class="text-primary hover:underline font-bold text-base">+91 96332 11151</a>
              </div>
            </div>

            <div class="flex items-start gap-3.5">
              <span class="material-symbols-outlined text-primary text-xl mt-0.5">chat</span>
              <div>
                <strong class="text-on-surface block text-base font-bold mb-0.5">WhatsApp Admissions</strong>
                <a href="https://wa.me/919633211151" target="_blank" class="text-green-500 hover:underline font-semibold">+91 96332 11151 (Instant Reply)</a>
              </div>
            </div>

            <div class="flex items-start gap-3.5">
              <span class="material-symbols-outlined text-primary text-xl mt-0.5">mail</span>
              <div>
                <strong class="text-on-surface block text-base font-bold mb-0.5">Official Email</strong>
                <a href="mailto:connect@livart.co.in" class="hover:text-primary transition-colors">connect@livart.co.in</a>
              </div>
            </div>

            <div class="flex items-start gap-3.5">
              <span class="material-symbols-outlined text-outline text-xl mt-0.5">schedule</span>
              <div>
                <strong class="text-on-surface block text-base font-bold mb-0.5">Campus Hours</strong>
                Monday – Friday: 10:00 AM – 5:00 PM<br/>Sunday: Closed
              </div>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-outline-variant/15 flex items-center gap-4">
            <span class="text-xs uppercase tracking-wider text-outline font-bold">Follow Academy:</span>
            <a href="https://www.instagram.com/livart_academy/" target="_blank" class="p-2.5 bg-surface-container rounded-full hover:bg-primary hover:text-on-primary transition-colors text-on-surface" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
            <a href="https://www.facebook.com/livart.academy/" target="_blank" class="p-2.5 bg-surface-container rounded-full hover:bg-primary hover:text-on-primary transition-colors text-on-surface" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          </div>
        </div>

        <!-- Campus Image -->
        <div class="rounded-2xl overflow-hidden border border-outline-variant/15 shadow-md">
          <img src="/images/academy-live/livart_academy_campus_overview.jpg" alt="Livart Academy Campus Kalamassery" class="w-full h-48 object-cover" />
        </div>
      </div>

      <!-- Lead Capture Form (Right column) -->
      <div class="lg:col-span-7">
        <CourseLeadForm 
          courseName="Cosmetology Programme (12 Months)"
          title="Direct Admissions Application"
          subtitle="Submit your application below. Our admissions desk will send the full course prospectus, module curriculum, and current fee schedule directly to your WhatsApp."
          formId="contact-page-lead-form"
        />
      </div>
    </div>
  </section>
</Layout>