---
import Layout from '../../../layouts/Layout.astro';
import CourseLeadForm from '../../../components/CourseLeadForm.astro';
import InstagramReelCard from '../../../components/InstagramReelCard.astro';

const featuredReels = [
  {
    url: "https://www.instagram.com/reel/Cj9gISlIba1/",
    image: "/images/academy-live/ig_student_testimonial_nimmy.jpg",
    category: "സ്റ്റുഡന്റ് സ്പോട്ട്‌ലൈറ്റ്",
    title: "വിദ്യാർത്ഥിനി നിമ്മി കളത്തിൽ — അനുഭവം",
    description: "മുൻപരിചയമില്ലാതെ തുടങ്ങി പ്രൊഫഷണൽ ബ്രൈഡൽ മേക്കപ്പ് ആർട്ടിസ്റ്റായി മാറിയ വിദ്യാർത്ഥിനിയുടെ യഥാർത്ഥ അനുഭവം."
  },
  {
    url: "https://www.instagram.com/livart_academy/",
    image: "/images/academy-live/bridal_masterclass_pathadipalam.jpg",
    category: "ബ്രൈഡൽ മാസ്റ്റർക്ലാസ്സ്",
    title: "മുഹൂർത്ത സാരി & ടെമ്പിൾ ബ്രൈഡൽ ആർട്ട്",
    description: "പരമ്പരാഗത കേരള കസവു സാരി ഡ്രേപ്പിംഗും 4K ഹൈ-ഡെഫനിഷൻ കോംപ്ലക്ഷൻ ബേസും ലൈവ് മോഡലുകളിൽ."
  },
  {
    url: "https://www.instagram.com/livart_academy/",
    image: "/images/academy-live/loreal_hair_spa_practical.jpg",
    category: "ഹെയർ ആർക്കിടെക്ചർ",
    title: "L'Oréal പ്രൊഫഷണൽ ഹെയർ സ്പാ പ്രാക്ടിക്കൽസ്",
    description: "ക്ലിനിക്കൽ സ്കാൽപ്പ് പരിശോധന, ഡീപ് കെരാറ്റിൻ കണ്ടീഷനിംഗ്, സലൂൺ ബ്ലോ ഔട്ടുകൾ എന്നിവയിൽ ലൈവ് ട്രെയിനിംഗ്."
  },
  {
    url: "https://www.instagram.com/p/Dc-ULHvEvKu/",
    image: "/images/academy-live/ig_makeup_artistry_showcase.jpg",
    category: "മേക്കപ്പ് ആർട്ടിസ്ട്രി",
    title: "പ്രിസിഷൻ കട്ട്-ക്രീസ് & കളർ തിയറി",
    description: "അഡ്വാൻസ്ഡ് സിമ്മട്രി കാലിബ്രേഷൻ, സ്മോക്കി ഐസ്, ഗ്ലാസ് സ്കിൻ ഫിനിഷ് മാസ്റ്റർക്ലാസ്സ് ഡെമോൺസ്ട്രേഷൻ."
  },
