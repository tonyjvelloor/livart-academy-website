---
import Layout from '../../../layouts/Layout.astro';
import CourseLeadForm from '../../../components/CourseLeadForm.astro';
import InstagramReelCard from '../../../components/InstagramReelCard.astro';
import CoursePrintButton from '../../../components/CoursePrintButton.astro';
import CoursePrintProspectus from '../../../components/CoursePrintProspectus.astro';

const mlSalonJobModules = [
  { num: "01", title: "സലൂൺ ബ്ലോ ഡ്രൈ & സ്റ്റൈലിംഗ് സെറ്റിംഗ്", desc: "റൗണ്ട് ബ്രഷ്, പാഡിൽ ബ്രഷ്, വോളിയം സ്റ്റൈലിംഗ്, സ്ലീക്ക് കൊമേർഷ്യൽ ഫിനിഷിംഗ്." },
  { num: "02", title: "ഷാംപൂ, ഹെയർ വാഷ് & ബേസിൻ എറ്റിക്കറ്റ്", desc: "ശരിയായ ബേസിൻ പോസ്ചർ, സ്കാൽപ് മസാജ്, ഡീപ് ക്ലെൻസിംഗ്, ക്ലയന്റ് ഡ്രേപ്പിംഗ് & ശുചിത്വം." },
  { num: "03", title: "ബേസിക് ഹെയർകട്ടുകൾ (U, V, സ്ട്രെയിറ്റ് & ലെയർ)", desc: "സലൂണുകളിൽ ആവശ്യമായ സ്ട്രെയിറ്റ് കട്ട്, U-കട്ട്, V-കട്ട്, ബേസിക് ലെയർ കട്ടുകൾ." },
  { num: "04", title: "റൂട്ട് ടച്ച്-അപ്പ് & ക്വിക്ക് കളറിംഗ്", desc: "ഗ്രേ കവറേജ്, മിക്സിംഗ് റേഷ്യോ, പാടുകൾ വരാതെയുള്ള കൃത്യമായ ആപ്ലിക്കേഷൻ & പോസ്റ്റ്-വാഷ് കെയർ." },
  { num: "05", title: "പരമ്പരാഗത ഓയിൽ മസാജ് & ഹെയർ സ്പാ", desc: "അക്യുപ്രഷർ പ്രഷർ പോയിന്റുകൾ, ബ്ലഡ് സർക്കുലേഷൻ തെറാപ്പി, സ്റ്റീം മാസ്ക് പ്രോട്ടോക്കോളുകൾ." },
  { num: "06", title: "പ്രിസിഷൻ ത്രെഡിംഗ് വൈദഗ്ദ്ധ്യം", desc: "ഐബ്രോ മാപ്പിംഗ്, ആർച്ച് ഡിസൈനിംഗ്, അപ്പർ ലിപ്, ചിൻ, ഫുൾ ഫേസ് ത്രെഡിംഗ്." },
  { num: "07", title: "കൊമേർഷ്യൽ ഫേഷ്യലുകൾ & ക്ലീൻ-അപ്പ്", desc: "ഫേഷ്യൽ മസാജ് സ്ട്രോക്കുകൾ, സ്റ്റീമിംഗ്, ബ്ലാക്ക്‌ഹെഡ് എക്സ്ട്രാക്ഷൻ, ക്ലേ/ക്രീം മാസ്കുകൾ." },
  { num: "08", title: "മാനിക്യൂർ & പെഡിക്യൂർ പ്രോട്ടോക്കോളുകൾ", desc: "നഖങ്ങൾ ഫയൽ ചെയ്യൽ, ക്യൂട്ടിക്കിൾ കെയർ, ഡെഡ് സ്കിൻ സ്ക്രബ്ബിംഗ്, ഫുട്ട് മസാജ്." },
  { num: "09", title: "ബേസിക് ടു അഡ്വാൻസ്ഡ് വാക്സിംഗ്", desc: "കൈകൾ, കാലുകൾ, അണ്ടർആംസ് വാക്സിംഗ് രീതികൾ, പോസ്റ്റ്-വാക്സ് സൂതിംഗ് കെയർ." }
];
---

<Layout 
  title="ജോബ്-ഓറിയന്റഡ് സലൂൺ കോഴ്സ് (1 മാസം) | Livart Beauty Academy Kochi"
  description="കൊച്ചിയിലെ മികച്ച 1 മാസത്തെ ജോബ്-ഓറിയന്റഡ് സലൂൺ കോഴ്സ്. ബ്ലോ ഡ്രൈ, ഹെയർകട്ടുകൾ, ഫേഷ്യൽ, റൂട്ട് ടച്ച്-അപ്പ്, പെഡിക്യൂർ, ത്രെഡിംഗ് എന്നിവയിൽ സമഗ്ര പരിശീലനം നേടി ഉടൻ ജോലി നേടാം."
>
  <div class="screen-only">
  <!-- HERO -->
  <section class="relative pt-24 pb-16 px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto border-b border-outline-variant/20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter-lg items-center">
      <div>
        <div class="inline-flex items-center gap-space-xs px-3 py-1 rounded-full bg-primary/10 border border-primary/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="font-label-sm uppercase tracking-widest text-primary text-xs font-bold">1 മാസത്തെ ആക്സിലറേറ്റഡ് ജോബ് ട്രാക്ക് • 2026 അഡ്മിഷൻ</span>
        </div>
        <h1 class="font-display-lg text-display-lg lg:text-[60px] lg:leading-[68px] text-on-surface tracking-tight mb-6">
          ജോബ്-ഓറിയന്റഡ് <span class="italic text-primary">സലൂൺ കോഴ്സ്.</span>
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl leading-relaxed mb-8">
          പഠനം പൂർത്തിയാക്കി ഉടൻ തന്നെ സലൂണുകളിൽ ജോലി നേടാൻ സഹായിക്കുന്ന തരത്തിൽ രൂപകൽപ്പന ചെയ്ത കോഴ്സ്. ഹെയർ, സ്കിൻ മേഖലകളിലെ ഏറ്റവും ഡിമാൻഡുള്ള സലൂൺ ജോലികൾ 1 മാസത്തിനുള്ളിൽ നേരിട്ട് പഠിച്ചെടുക്കാം.
        </p>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8 border-y border-outline-variant/20 py-6">
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">കാലയളവ്</span>
            <strong class="font-title-md text-on-surface text-base">1 മാസം</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">ഫോക്കസ്</span>
            <strong class="font-title-md text-on-surface text-base">സലൂൺ സർവീസുകൾ</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">മേഖലകൾ</span>
            <strong class="font-title-md text-on-surface text-base">ഹെയർ & സ്കിൻ</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">പ്ലേസ്‌മെന്റ് സഹായം</span>
            <strong class="font-title-md text-on-surface text-base">സഹായം ലഭ്യമാണ്</strong>
          </div>
        </div>

        <div class="flex flex-wrap gap-4 items-center">
          <a href="#enroll" class="px-8 py-4 bg-primary text-on-primary font-label-md uppercase tracking-widest font-bold rounded shadow-lg hover:bg-primary-fixed transition-colors flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">download</span>
            സിലബസും ഫീസും വാട്ട്‌സ്ആപ്പിൽ നേടാം
          </a>
          <a href="#modules" class="px-6 py-4 bg-surface-container-high text-on-surface font-label-md uppercase tracking-widest rounded border border-outline-variant/30 hover:border-primary transition-colors">
            കരിക്കുലം കാണുക
          </a>
          <CoursePrintButton isMalayalam={true} />
        </div>
      </div>
      
      <div class="relative h-[480px] lg:h-[520px] rounded-2xl overflow-hidden bg-surface-container shadow-2xl">
        <img fetchpriority="high" decoding="async" src="/images/academy-live/cosmetology_career_options.jpg" class="w-full h-full object-cover" alt="ലിവ്ആർട്ട് സലൂൺ ട്രെയിനിങ്" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-8">
          <div class="inline-block px-3 py-1 bg-primary text-white text-xs uppercase tracking-widest font-bold rounded mb-2 w-max">
            നേരിട്ടുള്ള ജോലി സാധ്യത
          </div>
          <h3 class="font-headline-sm text-white text-xl font-bold">വേഗത്തിൽ സലൂൺ കരിയർ തുടങ്ങാം</h3>
          <p class="text-white/80 font-body-sm text-sm mt-1">സ്റ്റാൻഡേർഡ് സലൂൺ സർവീസുകളിൽ പ്രാവീണ്യം നേടി 30 ദിവസത്തിനുള്ളിൽ ജോലിക്ക് തയ്യാറാകൂ.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MODULES: HAIR & SKIN -->
  <section id="modules" class="py-space-xl px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto">
    <div class="max-w-3xl mb-space-xl text-center mx-auto">
      <span class="font-label-sm uppercase tracking-widest text-primary block mb-2 font-bold">പ്രാക്ടിക്കൽ കരിക്കുലം</span>
      <h2 class="font-display-lg text-display-lg text-on-surface tracking-tight">സലൂണുകൾ ആദ്യദിനം ആവശ്യപ്പെടുന്ന എല്ലാ കഴിവുകളും.</h2>
      <p class="font-body-lg text-on-surface-variant mt-4">സലൂണുകളിൽ നിത്യേന ആവശ്യമായി വരുന്ന ഏറ്റവും പ്രധാനപ്പെട്ട സർവീസുകൾ 100% നേരിട്ട് പരിശീലിക്കാം:</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter-lg">
      <!-- HAIR SECTION -->
      <div class="bg-surface-container-low p-space-lg rounded-2xl border border-outline-variant/20 shadow-xl">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/20">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
            <span class="material-symbols-outlined">content_cut</span>
          </div>
          <div>
            <span class="font-label-sm uppercase tracking-widest text-primary font-bold text-xs">ഭാഗം 1</span>
            <h3 class="font-headline-sm text-2xl font-bold text-on-surface">സലൂൺ ഹെയർ സർവീസുകൾ</h3>
          </div>
        </div>

        <ul class="space-y-4 font-body-md text-on-surface-variant">
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>ബ്ലോ ഡ്രൈ & സെറ്റിംഗ്:</strong> റൗണ്ട് ബ്രഷ്, പാഡിൽ ബ്രഷ് ഉപയോഗിച്ചുള്ള വോളിയം സ്റ്റൈലിംഗും സ്ലീക്ക് ഫിനിഷും.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>ഷാംപൂ, ഹെയർ വാഷ് & ബേസിൻ രീതികൾ:</strong> കറക്റ്റ് ബേസിൻ പൊസിഷൻ, വാട്ടർ ടെമ്പറേച്ചർ കൺട്രോൾ, ഡീപ് ക്ലെൻസിംഗ്.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>ടവൽ ഡ്രേപ്പിംഗ് & ശുചിത്വം:</strong> സ്റ്റെറൈൽ സലൂൺ ഡ്രേപ്പ് സെറ്റപ്പ്, സാനിറ്റൈസേഷൻ, പ്രൊഫഷണൽ ക്ലയന്റ് കെയർ.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>അടിസ്ഥാന ഹെയർകട്ടുകൾ:</strong> സ്ട്രെയിറ്റ് കട്ട്, U-കട്ട്, V-കട്ട്, ബേസിക് കൊമേഴ്ഷ്യൽ ലെയർ കട്ടുകൾ.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>റൂട്ട് ടച്ച്-അപ്പ് & ക്വിക്ക് കളറിംഗ്:</strong> ഗ്രേ കവറേജ്, മിക്സിംഗ് റേഷ്യോകൾ, പാടുകൾ ഇല്ലാതെ വൃത്തിയായി അപ്ലൈ ചെയ്യുന്ന രീതി.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>ഓയിൽ മസാജ് & സ്കാൽപ് സ്പാ:</strong> പ്രഷർ പോയിന്റുകൾ, ബ്ലഡ് സർക്കുലേഷൻ തെറാപ്പി, സ്റ്റീം മാസ്ക് രീതികൾ.</div>
          </li>
        </ul>
      </div>

      <!-- SKIN SECTION -->
      <div class="bg-surface-container-low p-space-lg rounded-2xl border border-outline-variant/20 shadow-xl">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/20">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
            <span class="material-symbols-outlined">spa</span>
          </div>
          <div>
            <span class="font-label-sm uppercase tracking-widest text-primary font-bold text-xs">ഭാഗം 2</span>
            <h3 class="font-headline-sm text-2xl font-bold text-on-surface">സലൂൺ സ്കിൻ സർവീസുകൾ</h3>
          </div>
        </div>

        <ul class="space-y-4 font-body-md text-on-surface-variant">
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>പ്രിസിഷൻ ത്രെഡിംഗ്:</strong> ഐബ്രോ മാപ്പിംഗ്, ആർച്ച് ഡെഫിനിഷൻ, അപ്പർ ലിപ്, ചിൻ, ഫുൾ ഫേസ് ത്രെഡിംഗ്.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>കൊമേഴ്ഷ്യൽ ഫേഷ്യലുകൾ:</strong> ഫേഷ്യൽ മസാജ് സ്ട്രോക്കുകൾ, സ്റ്റീമിംഗ്, എക്സ്ട്രാക്ഷൻ, ക്ലേ/ക്രീം മാസ്ക് സെറ്റിംഗ്.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>സലൂൺ ക്ലീൻ അപ്പ്:</strong> 30 മിനിറ്റ് ഡീപ് പോർ ക്ലെൻസിംഗ്, ബ്ലാക്ക്ഹെഡ് എക്സ്ട്രാക്ഷൻ, സൂത്തിംഗ് ടോണറുകൾ.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>മാനിക്യൂർ രീതികൾ:</strong> ക്യൂട്ടിക്കിൾ കെയർ, ഫയലിംഗ്, ബഫിംഗ്, ഹാൻഡ് മസാജ്, പോളിഷ് ആപ്ലിക്കേഷൻ.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>പെഡിക്യൂർ രീതികൾ:</strong> ഫൂട്ട് സോക്കിംഗ്, ഡെഡ് സ്കിൻ സ്ക്രബ്ബ്, കാല്ലസ് റിമൂവൽ, റിലാക്സേഷൻ മസാജ്.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>ഫുൾ ബോഡി വാക്സിംഗ്:</strong> ആംസ്, ലെഗ്സ്, അണ്ടർആംസ് വാക്സിംഗ്, ഹണി/സ്ട്രിപ്പ് വാക്സിംഗ് വേദന കുറഞ്ഞ രീതിയിൽ.</div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- LIVE STUDIO REELS -->
  <section class="py-space-xl bg-surface-container-lowest border-y border-outline-variant/20 px-margin-sm lg:px-margin-lg">
    <div class="max-w-[1440px] mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-space-lg gap-2">
