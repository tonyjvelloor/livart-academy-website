---
import Layout from '../../layouts/Layout.astro';
import CourseLeadForm from '../../components/CourseLeadForm.astro';
import InstagramReelCard from '../../components/InstagramReelCard.astro';
import CoursePrintButton from '../../components/CoursePrintButton.astro';
import CoursePrintProspectus from '../../components/CoursePrintProspectus.astro';

const cosmetologyModules = [
  { num: "01", title: "Hair Dressing Mastery (Stage 1)", desc: "13+ precision haircuts (Butterfly, Wolf, Bob, Graduation) • Nanoplastia, Botox, Keratin & Smoothing • Global colour, Balayage & Highlights • Hair spa & scalp treatments." },
  { num: "02", title: "Clinical Skin Therapy (Stage 2)", desc: "Skin anatomy & dermal analysis • Hydra facial machinery, High frequency & Galvanic iontophoresis • Chemical peels & anti-aging protocols • Manicure, pedicure & waxing." },
  { num: "03", title: "Master Makeup Artistry (Stage 3)", desc: "Hindu, Christian & Muslim bridal couture • 4K HD foundation matching & airbrush makeup • Thermal styling (crimping, tongs) • Advanced saree pre-pleating & draping." },
  { num: "04", title: "Commercial Salon Internship (Stage 4)", desc: "1-Month guaranteed internship on live working salon floor • Real client management, billing & appointment scheduling • High-volume speed, precision & service etiquette." },
  { num: "05", title: "Salon Business & Entrepreneurship", desc: "Salon setup, equipment sourcing & inventory control • Client consultation & retention mastery • Freelance bridal booking management • B&WSSC Govt certification exam." }
];
---

<Layout 
  title="Cosmetology Programme (12 & 6 Months) | Livart Beauty Academy Kochi"
  description="Master Hair, Skin, and Makeup with a mandatory 1-month salon floor internship at Livart Beauty Academy Kochi. B&WSSC-affiliated Cosmetology qualification for aspiring salon owners and top artists."
>
  <div class="screen-only">
  <!-- 1. HERO SECTION -->
  <section class="relative pt-24 pb-20 px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto border-b border-white/10 overflow-hidden">
    <!-- Ambient Red Glow -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="text-xs uppercase tracking-widest text-white/90 font-bold">
            Flagship Programme • 2026 Batches Open
          </span>
        </div>

        <h1 class="font-display-lg text-4xl sm:text-5xl lg:text-[62px] lg:leading-[70px] text-white tracking-tight font-normal text-balance">
          Complete Mastery in <br/>
          <span class="italic text-white/90 font-display-xl font-light">Cosmetology.</span>
        </h1>

        <p class="font-body-lg text-base sm:text-lg text-white/80 max-w-2xl leading-relaxed">
          The definitive all-in-one beauty qualification in Kerala. Integrating advanced <strong>Hair Dressing</strong>, <strong>Clinical Skin Aesthetics</strong>, and <strong>Bridal & Media Makeup</strong> with professional tool kits and a guaranteed <strong>1-month salon floor internship</strong>.
        </p>

        <!-- Quick Proof Indicators -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-4 border-y border-white/10">
          <div class="p-2">
            <span class="block text-[11px] uppercase tracking-wider text-white/50 mb-0.5">Available Tracks</span>
            <strong class="text-sm font-bold text-white">12M & 6M</strong>
          </div>
          <div class="p-2">
            <span class="block text-[11px] uppercase tracking-wider text-white/50 mb-0.5">Hands-On Practicals</span>
            <strong class="text-sm font-bold text-white">100% Live Models</strong>
          </div>
          <div class="p-2">
            <span class="block text-[11px] uppercase tracking-wider text-white/50 mb-0.5">Salon Floor</span>
            <strong class="text-sm font-bold text-white">1 Month Internship</strong>
          </div>
          <div class="p-2">
            <span class="block text-[11px] uppercase tracking-wider text-white/50 mb-0.5">Accreditation</span>
            <strong class="text-sm font-bold text-primary">B&WSSC / MSDE</strong>
          </div>
        </div>

        <!-- Call to Actions -->
        <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 sm:gap-4 pt-2">
          <a 
            href="#enroll" 
            class="px-8 py-4 bg-primary hover:bg-[#d40002] text-white font-label-md text-xs uppercase tracking-widest font-bold rounded-xl shadow-[0_0_25px_rgba(254,0,2,0.5)] transition-all duration-300 flex items-center justify-center gap-2 w-full sm:w-auto text-center min-h-[48px]"
          >
            <span class="material-symbols-outlined text-base">download</span>
            <span>Get Syllabus & Fee Details</span>
          </a>
          
          <a 
            href="#tracks" 
            class="px-6 py-4 bg-white/5 hover:bg-white/10 text-white font-label-md text-xs uppercase tracking-widest font-bold rounded-xl border border-white/10 transition-colors flex items-center justify-center w-full sm:w-auto text-center min-h-[48px]"
          >
            Compare 12M vs 6M
          </a>

          <CoursePrintButton label="Print Course Details" />

          <button 
            type="button" 
            class="inline-flex items-center justify-center gap-2 text-xs text-primary font-bold uppercase tracking-wider hover:underline cursor-pointer open-reel-modal py-2"
            data-reel-url="https://www.instagram.com/livart_academy/reel/DcIgaKVBb3R/"
            data-reel-title="Live Cosmetology Haircut & Blow Dry"
            data-reel-category="Atelier Practice"
          >
            <span class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center text-primary flex-shrink-0">
              <span class="material-symbols-outlined text-sm">play_arrow</span>
            </span>
            <span>Watch Student Reel (0:45)</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Visual Poster with Live Badge -->
      <div class="lg:col-span-5">
        <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-[0_20px_60px_rgba(0,0,0,0.8)] bg-[#131418] aspect-[4/5] group">
          <img 
            src="/images/academy-live/bwssc_diploma_cosmetology_gov.jpg" 
            alt="Livart Cosmetology Students in Studio Floor" 
            class="w-full h-full object-cover filter brightness-90 group-hover:scale-105 transition-transform duration-700"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/30 to-transparent pointer-events-none"></div>
          
          <!-- Floating Credential Badge -->
          <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
            <span class="px-3 py-1 rounded-full bg-black/75 backdrop-blur-md text-[11px] font-bold text-primary uppercase tracking-wider border border-white/10">
              Govt. Affiliated
            </span>
            <span class="px-3 py-1 rounded-full bg-black/75 backdrop-blur-md text-[11px] font-semibold text-white/90 border border-white/10">
              Kalamassery, Kochi
            </span>
          </div>

          <!-- Bottom Card Overlay -->
          <div class="absolute bottom-0 inset-x-0 p-6 space-y-2">
            <span class="text-xs uppercase font-bold tracking-widest text-primary">Triad Curriculum</span>
            <h3 class="font-headline-sm text-xl font-bold text-white">Hair + Skin + Makeup + Salon Floor</h3>
            <p class="text-xs text-white/75 leading-relaxed">
              Complete professional tool kits and genuine client handling before you graduate.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 2. TRACKS COMPARISON (12 Months vs 6 Months) -->
  <section id="tracks" class="py-20 px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto">
    <div class="max-w-3xl mb-16 text-center mx-auto">
      <span class="font-label-sm uppercase tracking-widest text-primary block mb-2 font-bold text-xs">
        Programme Structure
      </span>
      <h2 class="font-display-lg text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        Choose Your Cosmetology Pathway.
      </h2>
      <p class="font-body-lg text-white/70 mt-4 leading-relaxed">
        Both tracks include hands-on live model training, professional tool kits, and the mandatory 1-month operational salon floor internship.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      
      <!-- 12-MONTH MASTER TRACK (FLAGSHIP) -->
      <div class="relative p-8 sm:p-10 rounded-3xl bg-[#131418] border-2 border-primary shadow-[0_15px_40px_rgba(254,0,2,0.25)] flex flex-col justify-between">
        <div class="absolute -top-3.5 right-8 px-4 py-1 bg-primary text-white font-label-sm uppercase tracking-widest font-bold rounded-full text-[11px] shadow-lg">
          ★ Master Qualification
        </div>

        <div>
          <span class="text-xs uppercase tracking-widest text-primary font-bold block mb-1">
            Complete Professional Cosmetology
          </span>
          <h3 class="font-headline-md text-2xl sm:text-3xl font-bold text-white mb-3">
            12-Month Master Programme
          </h3>
          <p class="text-sm text-white/70 mb-8 leading-relaxed">
            The definitive route for future salon directors, senior cosmetologists, and salon entrepreneurs. Master every technical nuance across Hair, Skin, and Makeup.
          </p>

          <!-- Timeline Breakdown -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-8 text-center">
            <div class="p-3.5 rounded-xl bg-[#191b22] border border-white/10">
              <span class="block text-[10px] font-bold text-white/50 uppercase">Stage 1</span>
              <strong class="text-sm font-bold text-white block mt-0.5">4 Months</strong>
              <span class="text-[11px] text-primary font-semibold">Hair Dressing</span>
            </div>
            <div class="p-3.5 rounded-xl bg-[#191b22] border border-white/10">
              <span class="block text-[10px] font-bold text-white/50 uppercase">Stage 2</span>
              <strong class="text-sm font-bold text-white block mt-0.5">4 Months</strong>
              <span class="text-[11px] text-primary font-semibold">Skin Therapy</span>
            </div>
            <div class="p-3.5 rounded-xl bg-[#191b22] border border-white/10">
              <span class="block text-[10px] font-bold text-white/50 uppercase">Stage 3</span>
              <strong class="text-sm font-bold text-white block mt-0.5">3 Months</strong>
              <span class="text-[11px] text-primary font-semibold">Makeup Master</span>
            </div>
            <div class="p-3.5 rounded-xl bg-primary/10 border border-primary/30">
              <span class="block text-[10px] font-bold text-primary uppercase">Stage 4</span>
              <strong class="text-sm font-bold text-primary block mt-0.5">1 Month</strong>
              <span class="text-[11px] text-white/80 font-semibold">Salon Floor</span>
            </div>
          </div>

          <!-- Curriculum Highlights -->
          <div class="space-y-3.5 text-xs text-white/80 mb-8">
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary text-base flex-shrink-0 mt-0.5">check_circle</span>
              <span><strong>Hair Dressing Mastery (4M):</strong> 13+ precision haircut types (Butterfly, Wolf, Graduated Bob), Nanoplastia, Botox, Balayage, and Ombre.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary text-base flex-shrink-0 mt-0.5">check_circle</span>
              <span><strong>Clinical Skin Therapy (4M):</strong> Hydra facial machinery, High frequency, Galvanic, chemical exfoliation, and anti-aging protocols.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary text-base flex-shrink-0 mt-0.5">check_circle</span>
              <span><strong>Master Makeup Artistry (3M):</strong> Hindu, Christian & Muslim bridal looks, 4K HD base, Airbrush, thermal hairstyles, and saree pre-pleating.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary text-base flex-shrink-0 mt-0.5">check_circle</span>
              <span><strong>Complete Professional Tool Kits Included:</strong> Cutting dummy, shears, combs, pro dryer, facial kit, extractor, and full brush set.</span>
            </div>
          </div>
        </div>

        <a 
          href="#enroll" 
          class="w-full py-4 bg-primary hover:bg-[#d40002] text-white font-label-md uppercase tracking-wider font-bold rounded-xl text-center shadow-[0_0_20px_rgba(254,0,2,0.4)] transition-all"
        >
          Inquire for 12-Month Master Batch
        </a>
      </div>

      <!-- 6-MONTH INTENSIVE TRACK -->
      <div class="p-8 sm:p-10 rounded-3xl bg-[#131418] border border-white/10 hover:border-white/25 shadow-xl flex flex-col justify-between transition-all">
        <div>
          <span class="text-xs uppercase tracking-widest text-white/60 font-bold block mb-1">
            Fast-Track Professional
          </span>
          <h3 class="font-headline-md text-2xl sm:text-3xl font-bold text-white mb-3">
            6-Month Intensive Programme
          </h3>
          <p class="text-sm text-white/70 mb-8 leading-relaxed">
            Accelerated 2+2+1 structure + 1 month internship. Designed for individuals who want direct salon floor employment in top salon chains quickly.
          </p>

          <!-- Timeline Breakdown -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-8 text-center">
            <div class="p-3.5 rounded-xl bg-[#191b22] border border-white/10">
              <span class="block text-[10px] font-bold text-white/50 uppercase">Stage 1</span>
              <strong class="text-sm font-bold text-white block mt-0.5">2 Months</strong>
              <span class="text-[11px] text-white/70 font-semibold">Hair Diploma</span>
            </div>
            <div class="p-3.5 rounded-xl bg-[#191b22] border border-white/10">
              <span class="block text-[10px] font-bold text-white/50 uppercase">Stage 2</span>
              <strong class="text-sm font-bold text-white block mt-0.5">2 Months</strong>
              <span class="text-[11px] text-white/70 font-semibold">Skin Therapy</span>
            </div>
            <div class="p-3.5 rounded-xl bg-[#191b22] border border-white/10">
              <span class="block text-[10px] font-bold text-white/50 uppercase">Stage 3</span>
              <strong class="text-sm font-bold text-white block mt-0.5">1 Month</strong>
              <span class="text-[11px] text-white/70 font-semibold">Makeup Track</span>
            </div>
            <div class="p-3.5 rounded-xl bg-primary/10 border border-primary/30">
              <span class="block text-[10px] font-bold text-primary uppercase">Stage 4</span>
              <strong class="text-sm font-bold text-primary block mt-0.5">1 Month</strong>
              <span class="text-[11px] text-white/80 font-semibold">Salon Floor</span>
            </div>
          </div>

          <!-- Curriculum Highlights -->
          <div class="space-y-3.5 text-xs text-white/80 mb-8">
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary text-base flex-shrink-0 mt-0.5">check_circle</span>
              <span><strong>Core Hair Diploma (2M):</strong> Essential salon cutting (One-length, graduation, layers, bob), Keratin, Smoothing, and Global colour.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary text-base flex-shrink-0 mt-0.5">check_circle</span>
              <span><strong>Skin Therapy Course (2M):</strong> Skin analysis, deep facials, High frequency acne treatments, De-tan, Waxing, and Threading.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary text-base flex-shrink-0 mt-0.5">check_circle</span>
              <span><strong>Foundation Makeup (1M):</strong> CTM, Color theory, Base contouring, Bridal demos (Hindu/Christian/Muslim), and Saree draping.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary text-base flex-shrink-0 mt-0.5">check_circle</span>
              <span><strong>Essential Tool Kits Included:</strong> Cutting dummy, scissors, comb sets, clips, and professional skin therapy kit.</span>
            </div>
          </div>
        </div>

        <a 
          href="#enroll" 
          class="w-full py-4 bg-white/10 hover:bg-white/20 text-white font-label-md uppercase tracking-wider font-bold rounded-xl text-center border border-white/15 transition-colors"
        >
          Inquire for 6-Month Intensive Batch
        </a>
      </div>

    </div>
  </section>

  <!-- 3. THE 4 STAGES ROADMAP -->
  <section class="py-20 bg-[#07080a] border-y border-white/10">
    <div class="max-w-[1440px] mx-auto px-margin-sm lg:px-margin-lg">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="font-label-sm uppercase tracking-widest text-primary text-xs font-bold block mb-2">Curriculum Roadmap</span>
        <h2 class="font-display-lg text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">Your 4-Stage Transformation Journey.</h2>
        <p class="font-body-lg text-white/70 mt-3">From foundation science to live commercial salon execution.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Stage 1 -->
        <div class="p-6 rounded-2xl bg-[#111317] border border-white/10 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-5">
              <span class="material-symbols-outlined text-2xl">content_cut</span>
            </div>
            <span class="text-[11px] uppercase tracking-widest text-primary font-bold block mb-1">Stage 01</span>
            <h3 class="font-headline-sm text-lg font-bold text-white mb-2">Hair Architecture</h3>
            <p class="text-xs text-white/70 leading-relaxed">
              Hair anatomy, scissors geometry, 13+ precision haircuts, texture re-bonding (Botox & Nanoplastia), and French Balayage colouring.
            </p>
          </div>
        </div>

        <!-- Stage 2 -->
        <div class="p-6 rounded-2xl bg-[#111317] border border-white/10 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-5">
              <span class="material-symbols-outlined text-2xl">spa</span>
            </div>
            <span class="text-[11px] uppercase tracking-widest text-primary font-bold block mb-1">Stage 02</span>
            <h3 class="font-headline-sm text-lg font-bold text-white mb-2">Skin Science & Dermal</h3>
            <p class="text-xs text-white/70 leading-relaxed">
              Medical-grade skin analysis, Hydra facial machinery, High frequency, Galvanic iontophoresis, chemical peels, and body waxing.
            </p>
          </div>
        </div>

        <!-- Stage 3 -->
        <div class="p-6 rounded-2xl bg-[#111317] border border-white/10 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-5">
              <span class="material-symbols-outlined text-2xl">brush</span>
            </div>
            <span class="text-[11px] uppercase tracking-widest text-primary font-bold block mb-1">Stage 03</span>
            <h3 class="font-headline-sm text-lg font-bold text-white mb-2">Haute Makeup Artistry</h3>
            <p class="text-xs text-white/70 leading-relaxed">
              Hindu, Christian & Muslim bridal looks, transfer-proof 4K HD finish, Airbrush application, thermal hairstyling, and saree pre-pleating.
            </p>
          </div>
        </div>

        <!-- Stage 4 -->
        <div class="p-6 rounded-2xl bg-[#111317] border border-primary/30 bg-primary/5 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-primary text-white flex items-center justify-center mb-5 shadow-lg">
              <span class="material-symbols-outlined text-2xl">storefront</span>
            </div>
            <span class="text-[11px] uppercase tracking-widest text-primary font-bold block mb-1">Stage 04</span>
            <h3 class="font-headline-sm text-lg font-bold text-white mb-2">Salon Floor Rotation</h3>
            <p class="text-xs text-white/70 leading-relaxed">
              1-month mandatory floor rotation inside LivArt commercial salons. Real client consultation, time management, and revenue workflows.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4. TOOLKITS INCLUDED -->
  <section class="py-20 px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="font-label-sm uppercase tracking-widest text-primary text-xs font-bold block mb-2">Equipment Provided</span>
      <h2 class="font-display-lg text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">Your Professional Tool Kits.</h2>
      <p class="font-body-lg text-white/70 mt-3">Every cosmetology student receives personal kits to use in class and keep for professional practice.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-[#131418] border border-white/10">
        <span class="text-xs font-bold uppercase tracking-widest text-primary block mb-2">Discipline 1</span>
        <h3 class="font-headline-sm text-xl font-bold text-white mb-3">Hair Styling Tool Kit</h3>
        <ul class="text-xs text-white/75 space-y-2">
          <li>• Cutting Dummy (1) for intensive precision practice</li>
          <li>• Professional Cutting & Thinning Scissors</li>
          <li>• Complete Comb Set & Section Clips</li>
          <li>• Professional Salon Hair Dryer</li>
        </ul>
      </div>

      <div class="p-6 rounded-2xl bg-[#131418] border border-white/10">
        <span class="text-xs font-bold uppercase tracking-widest text-primary block mb-2">Discipline 2</span>
        <h3 class="font-headline-sm text-xl font-bold text-white mb-3">Skin Care & Aesthetics Kit</h3>
        <ul class="text-xs text-white/75 space-y-2">
          <li>• Professional Facial Kit</li>
          <li>• Blackhead Extractor & Sterilization Tools</li>
          <li>• Threading Thread Spools</li>
          <li>• Waxing Applicators & Strips</li>
        </ul>
      </div>

      <div class="p-6 rounded-2xl bg-[#131418] border border-white/10">
        <span class="text-xs font-bold uppercase tracking-widest text-primary block mb-2">Discipline 3</span>
        <h3 class="font-headline-sm text-xl font-bold text-white mb-3">Makeup Artistry Kit</h3>
        <ul class="text-xs text-white/75 space-y-2">
          <li>• Individual Professional Makeup Brush Set</li>
          <li>• Blending Sponges & Powder Puffs</li>
          <li>• Eyebrow & Lash Spoolies</li>
          <li>• Saree Pre-Pleating Accessories & Pins</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. COSMETOLOGY IN MOTION (INTERACTIVE REELS) -->
  <section class="py-20 bg-[#07080a] border-y border-white/10">
    <div class="max-w-[1440px] mx-auto px-margin-sm lg:px-margin-lg">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-3">
        <div>
          <span class="font-label-sm text-primary uppercase tracking-widest text-xs font-bold block mb-1">
            Studio Outcomes in Motion
          </span>
          <h2 class="font-display-md text-2xl sm:text-4xl font-bold text-white tracking-tight">
            Watch Cosmetology Students in Action
          </h2>
          <p class="text-xs sm:text-sm text-white/70 mt-1">
            Click any reel to play the live video directly on our website.
          </p>
        </div>
        <a 
          href="https://www.instagram.com/livart_academy/" 
          target="_blank" 
          class="text-xs text-primary font-bold uppercase tracking-wider hover:underline flex items-center gap-1.5"
        >
          <span>More on @livart_academy</span>
          <span class="material-symbols-outlined text-sm">open_in_new</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <InstagramReelCard 
