---
import Layout from '../../layouts/Layout.astro';
import CourseLeadForm from '../../components/CourseLeadForm.astro';

const modules = [
  { num: "01", title: "Salon Basics", desc: "Salon manners / grooming & hygiene • Safety, tools & sterilization • Shampoo & conditioning • Blow-dry setting." },
  { num: "02", title: "Hair Fundamentals", desc: "Hair anatomy • Terms & methods of hair cutting • Scissors & comb • Parting & sectioning • Face shape." },
  { num: "03", title: "Basic to Advanced Haircuts", desc: "One-length • One-length variation • Forward graduation • Square layers • Stationary cut • Transient / transition cut • Round layers • Butterfly cut • Bob cut • Graduated bob cut • Bangs / fringes / curtain bangs • Wolf cut • Long layers • Customized haircuts." },
  { num: "04", title: "Relaxation Services", desc: "Oil massage • Hair spa • Anti-dandruff treatments." },
  { num: "05", title: "Hair Styling", desc: "Blow-dry settings • Tools knowledge • Ironing • Crimping • Tongs • Open hair styles • Front variations • Bun settings • Ponytail • Back combing • Hair extension fixing • Hair accessories styling • Pulling, spreading & pinching styles • Half pony with front variations • Types of braiding." },
  { num: "06", title: "Hair Colouring", desc: "Colour theories • Product knowledge • Foiling techniques • Root touch-ups • Global colouring • Highlights • Global + highlights • Balayage techniques • Ombre." },
  { num: "07", title: "Texturizing Treatments", desc: "Smoothing, Botox, Nanoplastia (theory & practicals each) • Theory includes hair bonds, hair texture, hair structure & related concepts." }
];
---

<Layout 
  title="Diploma in Hair Dressing (4 Months) | Livart Beauty Academy Kochi"
  description="Master 13+ precision haircuts, Nanoplastia, Botox, Balayage, and advanced hair styling in this 4-month Diploma in Hair Dressing at Livart Beauty Academy Kochi. Full tool kit included."
>
  <section class="relative pt-24 pb-16 px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto border-b border-outline-variant/20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter-lg items-center">
      <div>
        <div class="inline-flex items-center gap-space-xs px-3 py-1 rounded-full bg-primary/10 border border-primary/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="font-label-sm uppercase tracking-widest text-primary text-xs font-bold">4-Month Master Hair Track</span>
        </div>
        <h1 class="font-display-lg text-display-lg lg:text-[60px] lg:leading-[68px] text-on-surface tracking-tight mb-6">
          Diploma in <span class="italic text-primary">Hair Dressing.</span>
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl leading-relaxed mb-8">
          The definitive four-month qualification for elite hair stylists. Master precision cutting geometry, Nanoplastia, clinical Botox, Balayage foiling, and thermal bridal updos with your personal tool kit.
        </p>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8 border-y border-outline-variant/20 py-6">
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Duration</span>
            <strong class="font-title-md text-on-surface text-base">4 Months</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Haircuts Covered</span>
            <strong class="font-title-md text-on-surface text-base">13+ Styles</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Tool Kit</span>
            <strong class="font-title-md text-on-surface text-base">Kit + Dryer Inc.</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Accreditation</span>
            <strong class="font-title-md text-on-surface text-base">B&WSSC Verified</strong>
          </div>
        </div>

        <div class="flex flex-wrap gap-4">
          <a href="#enroll" class="px-8 py-4 bg-primary text-on-primary font-label-md uppercase tracking-widest font-bold rounded shadow-lg hover:bg-primary-fixed transition-colors flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">download</span>
            Get Syllabus & Fee Details
          </a>
        </div>
      </div>
      
      <div class="relative h-[480px] lg:h-[520px] rounded-2xl overflow-hidden bg-surface-container shadow-2xl">
        <img fetchpriority="high" decoding="async" src="/images/academy-live/hairstylist_graduation_ceremony.jpg" class="w-full h-full object-cover" alt="LivArt Hair Dressing Diploma Practical Training" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-8">
          <div class="inline-block px-3 py-1 bg-primary text-white text-xs uppercase tracking-widest font-bold rounded mb-2 w-max">
            Included in Course
          </div>
          <h3 class="font-headline-sm text-white text-xl font-bold">Personal Professional Hair Tool Kit</h3>
          <p class="text-white/80 font-body-sm text-sm mt-1">Cutting Dummy (1) • Comb Set • Cutting Scissors • Thinning Scissors • Section Clips • Professional Dryer</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7 MODULES -->
  <section class="py-space-xl bg-surface-container-lowest border-b border-outline-variant/20">
    <div class="max-w-[1440px] mx-auto px-margin-sm lg:px-margin-lg">
      <div class="max-w-3xl mb-space-xl">
        <span class="font-label-sm uppercase tracking-widest text-primary block mb-2 font-bold">Complete Curriculum</span>
        <h2 class="font-display-lg text-display-lg text-on-surface tracking-tight">The 7 Modules of Professional Hair Dressing.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {modules.map(m => (
          <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/15 flex flex-col justify-between">
            <div>
              <span class="font-label-sm text-primary uppercase tracking-widest font-bold text-xs block mb-1">Module {m.num}</span>
              <h3 class="font-headline-sm text-lg font-bold text-on-surface mb-2">{m.title}</h3>
              <p class="font-body-sm text-on-surface-variant text-xs leading-relaxed">{m.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LEAD CAPTURE -->
  <section id="enroll" class="py-space-xl px-margin-sm lg:px-margin-lg max-w-[900px] mx-auto scroll-mt-20">
    <CourseLeadForm 
      courseName="Diploma in Hair Dressing (4 Months)"
      title="Request Hair Dressing Syllabus & Fee Structure"
      subtitle="Fill in your details below to receive the complete 4-Month Hair Dressing prospectus, toolkit breakdown, and current fee schedule directly on WhatsApp."
      formId="hair-dressing-page-lead-form"
    />
  </section>

  <!-- SCHEMA -->
  <script type="application/ld+json" set:html={`
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "Diploma in Hair Dressing (4 Months)",
      "description": "4-month professional hair dressing diploma in Kochi covering 13+ precision haircuts, Nanoplastia, Botox, Balayage, and complete styling tool kit at Livart Beauty Academy.",
      "provider": {
        "@type": "EducationalOrganization",
        "name": "Livart Beauty Academy",
        "url": "https://livart.co.in"
      }
    }
  `} />
</Layout>
