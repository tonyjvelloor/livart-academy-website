---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CourseLeadForm from '../../components/CourseLeadForm.astro';

export async function getStaticPaths() {
  const locationEntries = await getCollection('locations');
  return locationEntries.map(entry => ({
    params: { location: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Fetch all other locations for internal cross-linking
const allLocations = await getCollection('locations');
const nearbyLocations = allLocations.filter(loc => loc.id !== entry.id);

// Featured core courses to showcase on every programmatic page
const featuredCourses = [
  {
    title: "Cosmetology Master Programme",
    duration: "12 & 6 Months",
    tag: "Government B&WSSC Certified",
    url: "/certification-course-in-cosmetology/",
    description: "Complete triad qualification combining hair architecture, clinical skin therapy, and commercial makeup with 1-month mandatory live salon floor internship.",
    highlights: ["Hair, Skin & Makeup Toolkits Included", "1-Month Live Salon Floor Internship", "International Attestation Eligible"]
  },
  {
    title: "Haute Bridal Makeup & Airbrush Artistry",
    duration: "10 Days to 3 Months",
    tag: "High Demand",
    url: "/bridal-makeup-course/",
    description: "Master 4K HD foundation blending, waterproof airbrush finishes, temple jewelry setting, and Kerala Christian, Hindu & Muslim bridal couture.",
    highlights: ["Live Model Practice", "Camera-tested 4K Studio", "Portfolio Photo & Reel Production"]
  },
  {
    title: "Diploma in Hair Dressing & Chemical Salon Floor",
    duration: "2 to 4 Months",
    tag: "Salon Master",
    url: "/hair-styling-course/",
    description: "Hands-on mastery of 13+ precision haircuts (Butterfly, Wolf, Classic Bob), Nanoplastia, Hair Botox, Balayage, and commercial salon coloring.",
    highlights: ["13+ Precision Haircuts", "Nanoplastia & Hair Botox", "Tool Kit Included with Practice Dummy"]
  },
  {
    title: "Clinical Skin Therapy & Aesthetics",
    duration: "2 to 4 Months",
    tag: "Clinical Aesthetics",
    url: "/skin-care-course/",
    description: "In-depth training on skin anatomy, chemical peels, Hydra-dermabrasion, Galvanic, Ultrasonic, and High-Frequency electrotherapy machines.",
    highlights: ["Clinical Electrotherapy Machines", "Chemical Peels & Hydra Facials", "Sanitization & Clinic Protocols"]
  }
];

// Rich Localized Schema: LocalBusiness + EducationalOrganization + FAQPage + Breadcrumbs
const locationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": `https://livart.co.in/academy/${entry.id}/#organization`,
      "name": `LivArt Beauty Academy - ${entry.data.city} Study Center`,
      "url": `https://livart.co.in/academy/${entry.id}/`,
      "logo": "https://livart.co.in/apple-touch-icon.png",
      "image": "https://livart.co.in/images/brand/livart-logo-horizontal.png",
      "telephone": "+91-9633211151",
      "priceRange": "₹₹",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Madukappilly Tower, Pathadipalam, Edappally P.O",
        "addressLocality": "Kalamassery, Kochi",
        "addressRegion": "Kerala",
        "postalCode": "682024",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "10.0436",
        "longitude": "76.3175"
      },
      "areaServed": {
        "@type": "City",
        "name": entry.data.city
      }
    },
    ...(entry.data.faqs && entry.data.faqs.length > 0 ? [{
      "@type": "FAQPage",
      "@id": `https://livart.co.in/academy/${entry.id}/#faq`,
      "mainEntity": entry.data.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }] : [])
  ]
};

const whatsappText = encodeURIComponent(`Hi LivArt Academy! I am from ${entry.data.city} and interested in your beauty and cosmetology courses. Please share syllabus and fee details.`);
---

<Layout 
  title={entry.data.title} 
  description={entry.data.description}
  schema={locationSchema}
>
  <!-- 1. BREADCRUMBS & HERO -->
  <section class="relative pt-24 sm:pt-32 pb-16 px-margin-sm lg:px-margin-lg max-w-[1280px] mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-label-sm text-on-surface-variant mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span class="text-white/30">/</span>
      <a href="/academy/" class="hover:text-primary transition-colors">Academy Centres</a>
      <span class="text-white/30">/</span>
      <span class="text-primary font-semibold">{entry.data.city}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/25 mb-5 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="font-label-sm uppercase tracking-widest text-primary text-xs font-bold">
            LivArt Academy • Serving {entry.data.city}
          </span>
        </div>

        <h1 class="font-display text-3xl sm:text-5xl lg:text-5xl font-bold tracking-tight text-on-surface leading-[1.15] mb-5">
          Best Beautician & Cosmetology Courses in <span class="text-primary italic">{entry.data.city}.</span>
        </h1>

        <p class="font-body-lg text-base sm:text-lg text-on-surface-variant leading-relaxed mb-6">
          {entry.data.description}
        </p>

        <!-- Fast Facts Pills -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-8">
          <div class="p-3.5 rounded-xl bg-surface-container border border-white/5 flex flex-col">
            <span class="text-xs text-on-surface-variant uppercase tracking-wider font-medium">Certification</span>
            <span class="text-sm font-bold text-on-surface mt-1">Govt B&WSSC / MSDE</span>
          </div>
          <div class="p-3.5 rounded-xl bg-surface-container border border-white/5 flex flex-col">
            <span class="text-xs text-on-surface-variant uppercase tracking-wider font-medium">Commute Time</span>
            <span class="text-sm font-bold text-primary mt-1">{entry.data.commuteTime}</span>
          </div>
          <div class="col-span-2 sm:col-span-1 p-3.5 rounded-xl bg-surface-container border border-white/5 flex flex-col">
            <span class="text-xs text-on-surface-variant uppercase tracking-wider font-medium">Placement</span>
            <span class="text-sm font-bold text-emerald-400 mt-1">100% Placement Support</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-4">
          <a 
            href={`https://wa.me/919633211151?text=${whatsappText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold transition-all shadow-lg shadow-emerald-900/30 font-label-md"
          >
            <span class="material-symbols-outlined text-xl">chat</span>
            WhatsApp Syllabus to {entry.data.city}
          </a>
          <a 
            href="tel:+919633211151"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-surface-container-high border border-white/10 hover:border-primary text-on-surface hover:text-primary transition-all font-semibold font-label-md"
          >
            <span class="material-symbols-outlined text-xl">call</span>
            Call Admissions
          </a>
        </div>
      </div>

      <!-- Hero Lead Capture Form -->
      <div class="lg:col-span-5">
        <CourseLeadForm 
          courseName={`Cosmetology Programme (${entry.data.city} Batch)`}
          title={`Enquire from ${entry.data.city}`}
          subtitle={`Get complete fee structure, syllabus brochure, and batch timings for students from ${entry.data.city}.`}
          formId={`lead-form-${entry.id}`}
        />
      </div>
    </div>
  </section>

  <!-- 2. TRANSIT & COMMUTE GUIDE (Proprietary Data for SEO & User Experience) -->
  <section class="py-12 bg-surface-container-low border-y border-white/5">
    <div class="max-w-[1280px] mx-auto px-margin-sm lg:px-margin-lg">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
        <div class="p-6 rounded-2xl bg-[#131418] border border-white/10">
          <div class="w-10 h-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-4">
            <span class="material-symbols-outlined">train</span>
          </div>
          <h3 class="text-base font-bold text-on-surface mb-1">Direct Metro Access</h3>
          <p class="text-xs text-primary font-semibold mb-2">{entry.data.metroRoute}</p>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Directly opposite Kochi Metro Pillar 382 at Pathadipalam Station with elevator and covered exit access.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#131418] border border-white/10">
          <div class="w-10 h-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-4">
            <span class="material-symbols-outlined">near_me</span>
          </div>
          <h3 class="text-base font-bold text-on-surface mb-1">Distance & Travel Duration</h3>
          <p class="text-xs text-primary font-semibold mb-2">{entry.data.distanceFromCampus} ({entry.data.commuteTime})</p>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Reliable daily commute via Kochi Metro rail, KSRTC, or direct highway connection along NH 544.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#131418] border border-white/10">
          <div class="w-10 h-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-4">
            <span class="material-symbols-outlined">hotel</span>
          </div>
          <h3 class="text-base font-bold text-on-surface mb-1">Hostel & Accommodation</h3>
          <p class="text-xs text-primary font-semibold mb-2">Safe Ladies' Hostels Available</p>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Verified ladies' PG and hostel accommodations within 5 minutes walking distance for outstation students.
          </p>
        </div>
      </div>

      {entry.data.transportGuide && (
        <div class="mt-6 p-5 rounded-xl bg-surface-container border border-white/5 text-xs text-on-surface-variant leading-relaxed flex items-start gap-3">
          <span class="material-symbols-outlined text-primary text-base mt-0.5 shrink-0">directions</span>
          <span><strong>Transit Tip for {entry.data.city} Students:</strong> {entry.data.transportGuide}</span>
        </div>
      )}
    </div>
  </section>

  <!-- 3. TOP PROFESSIONAL COURSES MATRIX -->
  <section class="py-16 sm:py-20 px-margin-sm lg:px-margin-lg max-w-[1280px] mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs uppercase tracking-widest text-primary font-bold">Industry Vetted Curriculums</span>
      <h2 class="font-display text-2xl sm:text-4xl font-bold text-on-surface mt-2 mb-4">
        Beauty & Cosmetology Diplomas for {entry.data.city} Students
      </h2>
      <p class="text-sm sm:text-base text-on-surface-variant">
        Every programme is designed to take you from foundational basics to certified master artist with individual practice kits and live salon floor client experience.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredCourses.map(course => (
        <div class="p-6 sm:p-8 rounded-2xl bg-surface-container border border-white/10 hover:border-primary/50 transition-all duration-300 flex flex-col justify-between group shadow-xl">
          <div>
            <div class="flex items-center justify-between gap-4 mb-4">
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-primary/10 text-primary border border-primary/20">
                {course.tag}
              </span>
              <span class="text-xs font-medium text-on-surface-variant flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">schedule</span>
                {course.duration}
              </span>
            </div>

            <h3 class="font-display text-xl sm:text-2xl font-bold text-on-surface group-hover:text-primary transition-colors mb-3">
              {course.title}
            </h3>

            <p class="text-sm text-on-surface-variant mb-5 leading-relaxed">
              {course.description}
            </p>

            <ul class="space-y-2 mb-6">
              {course.highlights.map(item => (
                <li class="flex items-center gap-2 text-xs text-on-surface">
                  <span class="material-symbols-outlined text-primary text-sm shrink-0">check_circle</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-4 border-t border-white/5 flex items-center justify-between">
            <a 
              href={course.url} 
              class="text-xs font-bold text-primary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 uppercase tracking-wider"
            >
              Explore Course Details
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
            <a 
              href={`https://wa.me/919633211151?text=${encodeURIComponent(`Hi! I am from ${entry.data.city} and want fee details for ${course.title}.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-emerald-400 hover:text-emerald-300 font-medium inline-flex items-center gap-1"
            >
              <span class="material-symbols-outlined text-sm">chat</span>
              Quick Fee Query
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. LOCATION SPECIFIC EDITORIAL CONTENT -->
  <section class="py-12 px-margin-sm lg:px-margin-lg max-w-[1000px] mx-auto border-t border-white/10">
    <div class="prose prose-invert prose-p:text-on-surface-variant prose-headings:text-on-surface prose-headings:font-display prose-a:text-primary max-w-none">
      <Content />
    </div>
  </section>

  <!-- 5. LOCALIZED FAQS ACCORDION -->
  {entry.data.faqs && entry.data.faqs.length > 0 && (
    <section class="py-16 px-margin-sm lg:px-margin-lg max-w-[1000px] mx-auto border-t border-white/10">
      <div class="text-center mb-10">
        <span class="text-xs uppercase tracking-widest text-primary font-bold">Frequently Asked Questions</span>
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-on-surface mt-2">
          Beauty Courses for {entry.data.city} Students
        </h2>
      </div>

      <div class="space-y-4">
        {entry.data.faqs.map(faq => (
          <details class="group p-5 rounded-xl bg-surface-container border border-white/5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-semibold text-on-surface text-base">
              <span>{faq.q}</span>
              <span class="material-symbols-outlined text-primary group-open:rotate-180 transition-transform">
                expand_more
              </span>
            </summary>
            <p class="mt-4 text-sm text-on-surface-variant leading-relaxed border-t border-white/5 pt-3">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>
  )}

  <!-- 6. CROSS-LINKING SPOKES (Programmatic SEO Hub & Spoke Connectivity) -->
  <section class="py-16 bg-surface-container-low border-t border-white/5">
    <div class="max-w-[1280px] mx-auto px-margin-sm lg:px-margin-lg">
      <div class="text-center mb-8">
        <span class="text-xs uppercase tracking-widest text-primary font-bold">Kochi Metro & Kerala Network</span>
        <h3 class="font-display text-xl sm:text-2xl font-bold text-on-surface mt-1">
          Explore LivArt Beauty Academy Across Kerala Hubs
        </h3>
        <p class="text-xs sm:text-sm text-on-surface-variant max-w-xl mx-auto mt-2">
          Discover our specialized cosmetology training centers, transit guides, and student batches across major Kerala catchments.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {nearbyLocations.map(loc => (
          <a 
            href={`/academy/${loc.id}/`}
            class="p-3.5 rounded-xl bg-[#131418] border border-white/5 hover:border-primary/50 text-center transition-all group flex flex-col items-center justify-center"
          >
            <span class="text-xs font-bold text-on-surface group-hover:text-primary transition-colors">
              {loc.data.city}
            </span>
            <span class="text-[10px] text-on-surface-variant mt-1">
              {loc.data.commuteTime}
            </span>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a 
          href="/academy/" 
          class="inline-flex items-center gap-2 text-xs font-bold text-primary hover:underline uppercase tracking-wider"
        >
          <span>View All 12 Kerala Academy Centres</span>
          <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
