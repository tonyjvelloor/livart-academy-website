---
import Layout from '../layouts/Layout.astro';
import CourseLeadForm from '../components/CourseLeadForm.astro';
import InstagramReelCard from '../components/InstagramReelCard.astro';
---

<Layout title="Livart Beauty Academy | Professional Beauty Education in Kochi">
	<div class="flex flex-col w-full text-on-surface">
		
		<!-- 1. HERO SECTION -->
		<section class="relative min-h-[85vh] flex flex-col justify-center items-center text-center px-margin-sm lg:px-margin-lg overflow-hidden py-space-xl">
			<div class="relative z-10 max-w-5xl mx-auto flex flex-col items-center">
				<div class="inline-flex flex-wrap items-center justify-center gap-2 px-4 py-1.5 rounded-full bg-surface-container-high/90 border border-outline-variant/30 mb-space-lg shadow-sm">
					<a href="https://www.instagram.com/livart_academy?utm_source=ig_web_button_share_sheet&srtk=ZDNlZDc0MzIxNw==" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-on-surface hover:text-primary transition-colors font-medium">
						<svg class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
						<span class="font-semibold text-primary">@livart_academy</span>
					</a>
					<span class="text-outline/40">•</span>
					<span class="font-label-sm text-label-sm uppercase tracking-[0.16em] text-on-surface font-semibold">
						Kerala’s Finest Beauty Academy • 2026 Admissions Open
					</span>
				</div>
				
				<h1 class="font-display-xl text-display-xl lg:text-[72px] lg:leading-[80px] tracking-tight text-white max-w-4xl mb-space-md text-balance">
					Professional Beauty Education. <br/>
					<span class="italic font-display-xl text-white/90">Built for Real Careers.</span>
				</h1>
				
				<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto mb-space-xl leading-relaxed text-pretty">
					Turn passion into profession with Kerala’s premier B&WSSC-certified beauty education atelier in Kalamassery, Kochi. Master hair architecture, bridal couture, clinical dermal aesthetics, and salon management on live clients.
				</p>
				
				<div class="flex flex-col sm:flex-row items-center gap-space-md mb-space-xl">
					<a class="inline-flex items-center justify-center px-8 py-4 bg-primary text-white font-label-md text-label-md uppercase tracking-widest transition-all duration-300 shadow-md hover:bg-primary-fixed font-bold rounded" href="/overview/">
						Explore Courses
					</a>
					<a class="inline-flex items-center justify-center px-8 py-4 bg-surface-container-high text-on-surface font-label-md text-label-md uppercase tracking-widest hover:border-primary transition-all duration-300 border border-outline-variant/30 rounded" href="/contact-us/">
						Talk to Admissions
					</a>
				</div>

				<!-- ELEMENT 1: HERO ESTABLISHMENT VISUAL SHOWCASE (Atelier Floor & Bridal Suite) -->
				<div class="w-full max-w-5xl mt-space-md grid grid-cols-1 md:grid-cols-2 gap-space-md text-left">
					<!-- Window 1: Live Salon Floor & Hair Architecture -->
					<div class="group relative rounded-2xl overflow-hidden border border-outline-variant/40 bg-surface-container-low shadow-xl transition-all duration-300 hover:border-primary/40">
						<div class="aspect-[16/10] sm:aspect-[16/9] w-full overflow-hidden relative">
							<img 
								fetchpriority="high" 
								decoding="async" 
								src="/images/academy-live/future_artists_live_atelier.jpg" 
								alt="LivArt Academy live hair architecture and client styling floor" 
								class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
							
							<div class="absolute top-3 left-3">
								<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/15 text-[10px] font-bold uppercase tracking-wider text-white">
									<span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
									Kalamassery Flagship Atelier
								</span>
							</div>
							
							<div class="absolute bottom-3.5 left-4 right-4">
								<span class="text-[10px] uppercase font-bold tracking-widest text-primary block mb-1">Hair Architecture & Styling</span>
								<h3 class="text-white font-headline-sm text-base md:text-lg font-bold leading-tight">Live Salon Floor & Client Experience</h3>
								<p class="text-white/75 text-xs mt-1 font-body-sm line-clamp-1">Practical training on live clients inside our operational Kalamassery salon floors.</p>
							</div>
						</div>
					</div>

					<!-- Window 2: Master Bridal Couture Suite -->
					<div class="group relative rounded-2xl overflow-hidden border border-outline-variant/40 bg-surface-container-low shadow-xl transition-all duration-300 hover:border-primary/40">
						<div class="aspect-[16/10] sm:aspect-[16/9] w-full overflow-hidden relative">
							<img 
								fetchpriority="high" 
								decoding="async" 
								src="/images/academy-live/bridal_masterclass_pathadipalam.jpg" 
								alt="LivArt Bridal Studio traditional bridal transformation with temple jewelry" 
								class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
							
							<div class="absolute top-3 left-3">
								<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/15 text-[10px] font-bold uppercase tracking-wider text-white">
									<span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
									B&WSSC Accredited Floor
								</span>
							</div>
							
							<div class="absolute bottom-3.5 left-4 right-4">
								<span class="text-[10px] uppercase font-bold tracking-widest text-primary block mb-1">Bridal Artistry & Couture</span>
								<h3 class="text-white font-headline-sm text-base md:text-lg font-bold leading-tight">Master Bridal Transformations</h3>
								<p class="text-white/75 text-xs mt-1 font-body-sm line-clamp-1">Complete Hindu, Christian, and Muslim wedding looks with 4K HD and saree draping.</p>
							</div>
						</div>
					</div>
				</div>

			</div>
		</section>

		<!-- 2. TRUST STRIP -->
		<section class="w-full bg-surface-container-lowest py-space-md border-y border-outline-variant/20">
			<div class="max-w-[1440px] mx-auto px-margin-sm lg:px-margin-lg">
				<div class="grid grid-cols-2 md:grid-cols-4 gap-space-md text-center divide-x divide-outline-variant/20">
					<div class="flex flex-col items-center justify-center px-4">
						<span class="material-symbols-outlined text-primary text-3xl mb-2">verified</span>
						<span class="font-label-md uppercase tracking-wider text-on-surface">B&WSSC Affiliated</span>
					</div>
					<div class="flex flex-col items-center justify-center px-4">
						<span class="material-symbols-outlined text-primary text-3xl mb-2">back_hand</span>
						<span class="font-label-md uppercase tracking-wider text-on-surface">Hands-on Training</span>
					</div>
					<div class="flex flex-col items-center justify-center px-4">
						<span class="material-symbols-outlined text-primary text-3xl mb-2">school</span>
						<span class="font-label-md uppercase tracking-wider text-on-surface">Experienced Trainers</span>
					</div>
					<div class="flex flex-col items-center justify-center px-4">
						<span class="material-symbols-outlined text-primary text-3xl mb-2">location_on</span>
						<span class="font-label-md uppercase tracking-wider text-on-surface">Kalamassery, Kochi</span>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. WHY LIVART (Proof Pillars) -->
		<section class="w-full py-space-xl px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto">
			<div class="text-center max-w-3xl mx-auto mb-space-xl">
				<span class="font-label-sm text-label-sm uppercase tracking-widest text-primary block mb-space-xs">The Academy</span>
				<h2 class="font-display-lg text-display-lg text-on-surface tracking-tight">Structured for Professional Success.</h2>
				<p class="font-body-lg text-body-lg text-on-surface-variant mt-space-sm">
					We don't just teach techniques; we build professionals. Livart stands on three foundational pillars designed to transition you from student to sought-after artist.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter-lg">
				<div class="luxury-card p-space-lg rounded-2xl">
					<div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary mb-space-md">
						<span class="material-symbols-outlined text-2xl">brush</span>
					</div>
					<h3 class="font-headline-sm text-on-surface mb-3 text-xl font-bold">CRAFT</h3>
					<p class="font-body-md text-on-surface-variant leading-relaxed text-sm">
						Immersive, hands-on beauty, makeup, hair, and skin education. We prioritize practical application on live models over theoretical classroom lectures.
					</p>
				</div>
				<div class="luxury-card p-space-lg rounded-2xl">
					<div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary mb-space-md">
						<span class="material-symbols-outlined text-2xl">workspace_premium</span>
					</div>
					<h3 class="font-headline-sm text-on-surface mb-3 text-xl font-bold">CREDENTIAL</h3>
					<p class="font-body-md text-on-surface-variant leading-relaxed text-sm">
						Backed by B&WSSC affiliation and recognized under the Ministry of Skill Development. Our documented certification pathway adds instant authority to your resume.
					</p>
				</div>
				<div class="luxury-card p-space-lg rounded-2xl">
					<div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary mb-space-md">
						<span class="material-symbols-outlined text-2xl">trending_up</span>
					</div>
					<h3 class="font-headline-sm text-on-surface mb-3 text-xl font-bold">CAREER</h3>
					<p class="font-body-md text-on-surface-variant leading-relaxed text-sm">
						Training designed around actual salon workflows, freelance client management, bridal bookings, and real beauty-industry opportunities.
					</p>
				</div>
			</div>
		</section>

		<!-- ELEMENT 2: INSIDE THE ACADEMY (Atelier Infrastructure & Live Bays) -->
		<section class="w-full py-space-xl bg-surface-container-low border-y border-outline-variant/30">
			<div class="max-w-[1440px] mx-auto px-margin-sm lg:px-margin-lg">
				<div class="text-center max-w-3xl mx-auto mb-space-xl">
					<span class="font-label-sm text-label-sm uppercase tracking-widest text-primary block mb-space-xs font-bold">Physical Infrastructure</span>
					<h2 class="font-display-lg text-display-lg text-white tracking-tight text-balance">Inside The Academy. Built Like a Working Salon.</h2>
					<p class="font-body-lg text-body-lg text-on-surface-variant mt-space-sm text-pretty">
						We eliminated the desk-bound classroom. Our Kalamassery campus is configured as high-volume commercial salon floors, clinical aesthetics bays, and bridal master suites so you graduate industry-ready.
					</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter-lg mb-space-xl">
					<!-- Infrastructure Card 1: Clinical Skincare & Aesthetics Lab -->
					<div class="luxury-card rounded-2xl overflow-hidden flex flex-col group border border-outline-variant/30">
						<div class="aspect-[16/10] w-full overflow-hidden relative">
							<img 
								fetchpriority="high" 
								decoding="async" 
								src="/images/academy-live/hair_makeup_skin_foundation.jpg" 
								alt="Clinical skincare and aesthetics consultation bay at LivArt Academy" 
								class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
							<div class="absolute top-4 left-4">
								<span class="px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/20 text-white text-[11px] font-bold uppercase tracking-wider flex items-center gap-1.5">
									<span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
									Clinical Aesthetics Lab
								</span>
							</div>
							<div class="absolute bottom-4 left-5 right-5">
								<h3 class="text-white font-headline-sm text-xl font-bold">Clinical Dermal & Aesthetic Stations</h3>
							</div>
						</div>
						<div class="p-space-lg flex-1 flex flex-col justify-between">
							<p class="font-body-md text-on-surface-variant leading-relaxed text-sm mb-4">
								Equipped with modern aesthetic equipment including Hydra-facial vacuum infusion systems, high-frequency derma wands, galvanic units, and LED light therapy. Students practice clinical consultation, Fitzpatrick skin typing, and personalized treatment regimens.
							</p>
							<div class="grid grid-cols-2 gap-2 pt-4 border-t border-outline-variant/20 text-xs text-on-surface">
								<div class="flex items-center gap-2">
									<span class="material-symbols-outlined text-primary text-base">check_circle</span>
									<span>Hydra-Facial Systems</span>
								</div>
								<div class="flex items-center gap-2">
									<span class="material-symbols-outlined text-primary text-base">check_circle</span>
									<span>High-Frequency Units</span>
								</div>
								<div class="flex items-center gap-2">
									<span class="material-symbols-outlined text-primary text-base">check_circle</span>
									<span>Autoclave Sterilization</span>
								</div>
								<div class="flex items-center gap-2">
									<span class="material-symbols-outlined text-primary text-base">check_circle</span>
									<span>Chemical Peel Bays</span>
								</div>
							</div>
						</div>
					</div>

					<!-- Infrastructure Card 2: Precision Hair Architecture & Commercial Floor -->
					<div class="luxury-card rounded-2xl overflow-hidden flex flex-col group border border-outline-variant/30">
						<div class="aspect-[16/10] w-full overflow-hidden relative">
							<img 
								fetchpriority="high" 
								decoding="async" 
								src="/images/academy-live/loreal_hair_spa_practical.jpg" 
								alt="Commercial hairdressing stations and live client styling floor at LivArt" 
								class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
							<div class="absolute top-4 left-4">
								<span class="px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/20 text-white text-[11px] font-bold uppercase tracking-wider flex items-center gap-1.5">
									<span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
									Commercial Salon Floor
								</span>
							</div>
							<div class="absolute bottom-4 left-5 right-5">
								<h3 class="text-white font-headline-sm text-xl font-bold">Hairdressing & Chemical Processing Bays</h3>
							</div>
						</div>
						<div class="p-space-lg flex-1 flex flex-col justify-between">
							<p class="font-body-md text-on-surface-variant leading-relaxed text-sm mb-4">
								Operating directly inside our flagship Kalamassery salon with ergonomic hydraulic chairs, shadowless mirror illumination, and dedicated backwash stations. Students formulate L'Oréal and Wella treatments, execute precision haircuts, and manage client flow.
							</p>
							<div class="grid grid-cols-2 gap-2 pt-4 border-t border-outline-variant/20 text-xs text-on-surface">
								<div class="flex items-center gap-2">
									<span class="material-symbols-outlined text-primary text-base">check_circle</span>
									<span>Hydraulic Styling Bays</span>
								</div>
								<div class="flex items-center gap-2">
									<span class="material-symbols-outlined text-primary text-base">check_circle</span>
									<span>L'Oréal / Wella Color Bar</span>
								</div>
								<div class="flex items-center gap-2">
									<span class="material-symbols-outlined text-primary text-base">check_circle</span>
									<span>Nanoplastia & Botox</span>
								</div>
								<div class="flex items-center gap-2">
									<span class="material-symbols-outlined text-primary text-base">check_circle</span>
									<span>1M Live Client Internship</span>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Institutional Authority Metrics -->
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-space-md rounded-xl bg-surface-container border border-outline-variant/30 text-center">
					<div class="p-3">
						<span class="font-display-md text-2xl lg:text-3xl font-bold text-white block">20+</span>
						<span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px] mt-1 block">Years Salon Pedigree</span>
					</div>
					<div class="p-3">
						<span class="font-display-md text-2xl lg:text-3xl font-bold text-white block">100%</span>
						<span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px] mt-1 block">Live Model Training</span>
					</div>
					<div class="p-3">
						<span class="font-display-md text-2xl lg:text-3xl font-bold text-white block">B&WSSC</span>
						<span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px] mt-1 block">National Govt. Affiliation</span>
					</div>
					<div class="p-3">
						<span class="font-display-md text-2xl lg:text-3xl font-bold text-white block">1 Month</span>
						<span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px] mt-1 block">Salon Floor Internship</span>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. COURSE SYSTEM -->
		<section class="w-full py-space-xl bg-surface-container-lowest border-y border-outline-variant/20">
			<div class="max-w-[1440px] mx-auto px-margin-sm lg:px-margin-lg">
				<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl">
					<div class="max-w-xl">
						<span class="font-label-sm text-label-sm uppercase tracking-widest text-primary block mb-space-xs font-bold">Curriculum</span>
						<h2 class="font-display-lg text-display-lg text-on-surface tracking-tight">Our Primary Courses.</h2>
					</div>
					<a href="/overview/" class="mt-space-md md:mt-0 font-label-md text-primary uppercase tracking-widest hover:underline flex items-center gap-2 font-bold text-xs">
						View All Courses <span class="material-symbols-outlined text-sm">arrow_forward</span>
					</a>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter-lg">
					
					<!-- Cosmetology (12M & 6M) -->
					<div class="luxury-card flex flex-col rounded-2xl overflow-hidden">
						<div class="p-space-lg flex-1">
							<div class="flex justify-between items-center mb-4">
								<span class="font-label-sm text-primary uppercase tracking-widest font-bold">12M & 6M Tracks</span>
								<span class="px-2 py-1 bg-surface-container-high text-xs rounded text-on-surface-variant font-bold">Master Flagship</span>
							</div>
							<h3 class="font-headline-sm text-on-surface mb-2 font-bold text-xl">Cosmetology Programme</h3>
							<p class="font-body-sm text-on-surface-variant mb-4 text-sm leading-relaxed">Hair, Skin, and Makeup triad with tool kits and a mandatory 1-month salon floor internship.</p>
							<div class="mb-6">
								<span class="font-label-sm uppercase text-outline block mb-2 text-xs font-bold">Highlights:</span>
								<div class="flex flex-wrap gap-1.5">
									<span class="px-2 py-1 bg-surface-container-high rounded text-xs text-on-surface">1M Internship</span>
									<span class="px-2 py-1 bg-surface-container-high rounded text-xs text-on-surface">Tool Kits Included</span>
									<span class="px-2 py-1 bg-surface-container-high rounded text-xs text-on-surface">B&WSSC Certified</span>
								</div>
							</div>
						</div>
						<a href="/certification-course-in-cosmetology/" class="p-4 bg-surface-container-high text-center font-label-md uppercase tracking-wider hover:bg-primary hover:text-on-primary transition-colors font-bold text-xs border-t border-outline-variant/20">View Syllabus & Details</a>
					</div>

					<!-- Makeup (3M & 1M) -->
					<div class="luxury-card flex flex-col rounded-2xl overflow-hidden">
						<div class="p-space-lg flex-1">
							<div class="flex justify-between items-center mb-4">
								<span class="font-label-sm text-primary uppercase tracking-widest font-bold">3M & 1M Tracks</span>
								<span class="px-2 py-1 bg-surface-container-high text-xs rounded text-on-surface-variant font-bold">Master Artistry</span>
							</div>
							<h3 class="font-headline-sm text-on-surface mb-2 font-bold text-xl">Diploma in Make-up Artistry</h3>
							<p class="font-body-sm text-on-surface-variant mb-4 text-sm leading-relaxed">Hindu, Christian & Muslim bridal looks, 4K HD, Airbrush, Hair Styling, and Saree Draping.</p>
							<div class="mb-6">
								<span class="font-label-sm uppercase text-outline block mb-2 text-xs font-bold">Highlights:</span>
								<div class="flex flex-wrap gap-1.5">
									<span class="px-2 py-1 bg-surface-container-high rounded text-xs text-on-surface">3 Bridal Looks</span>
									<span class="px-2 py-1 bg-surface-container-high rounded text-xs text-on-surface">Brush Kit Included</span>
									<span class="px-2 py-1 bg-surface-container-high rounded text-xs text-on-surface">Saree Pre-pleating</span>
								</div>
							</div>
						</div>
						<a href="/make-up-course/" class="p-4 bg-surface-container-high text-center font-label-md uppercase tracking-wider hover:bg-primary hover:text-on-primary transition-colors font-bold text-xs border-t border-outline-variant/20">View Syllabus & Details</a>
					</div>

					<!-- Hair (4M & 2M) -->
					<div class="luxury-card flex flex-col rounded-2xl overflow-hidden">
						<div class="p-space-lg flex-1">
							<div class="flex justify-between items-center mb-4">
								<span class="font-label-sm text-primary uppercase tracking-widest font-bold">4M & 2M Tracks</span>
								<span class="px-2 py-1 bg-surface-container-high text-xs rounded text-on-surface-variant font-bold">Hair Atelier</span>
							</div>
							<h3 class="font-headline-sm text-on-surface mb-2 font-bold text-xl">Hair Dressing & Styling</h3>
							<p class="font-body-sm text-on-surface-variant mb-4 text-sm leading-relaxed">13+ precision haircuts, Nanoplastia, Botox, Balayage, Ombre, and commercial hair styling.</p>
							<div class="mb-6">
								<span class="font-label-sm uppercase text-outline block mb-2 text-xs font-bold">Highlights:</span>
								<div class="flex flex-wrap gap-1.5">
