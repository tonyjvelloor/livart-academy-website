---
import Layout from '../../layouts/Layout.astro';
import CourseLeadForm from '../../components/CourseLeadForm.astro';
import InstagramReelCard from '../../components/InstagramReelCard.astro';
---

<Layout 
  title="Job-Oriented Salon Course (1 Month) | Livart Beauty Academy Kochi"
  description="Accelerated 1-month job-oriented salon course in Kochi. Master essential salon floor skills across hair and skin: blow dry, haircuts, facials, root touch-ups, pedicure, and threading for immediate employment."
>
  
  <!-- HERO -->
  <section class="relative pt-24 pb-16 px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto border-b border-outline-variant/20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter-lg items-center">
      <div>
        <div class="inline-flex items-center gap-space-xs px-3 py-1 rounded-full bg-primary/10 border border-primary/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="font-label-sm uppercase tracking-widest text-primary text-xs font-bold">1-Month Accelerated Job Track • 2026 Admissions</span>
        </div>
        <h1 class="font-display-lg text-display-lg lg:text-[60px] lg:leading-[68px] text-on-surface tracking-tight mb-6">
          Job-Oriented <span class="italic text-primary">Salon Course.</span>
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl leading-relaxed mb-8">
          Designed specifically for immediate salon employment. Learn the core everyday salon services across Hair and Skin that salon owners look for when hiring junior and floor stylists.
        </p>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8 border-y border-outline-variant/20 py-6">
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Duration</span>
            <strong class="font-title-md text-on-surface text-base">1 Month</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Focus</span>
            <strong class="font-title-md text-on-surface text-base">Salon Floor Skills</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Disciplines</span>
            <strong class="font-title-md text-on-surface text-base">Hair & Skin</strong>
          </div>
          <div>
            <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Job Assistance</span>
            <strong class="font-title-md text-on-surface text-base">Placement Support</strong>
          </div>
        </div>

        <div class="flex flex-wrap gap-4">
          <a href="#enroll" class="px-8 py-4 bg-primary text-on-primary font-label-md uppercase tracking-widest font-bold rounded shadow-lg hover:bg-primary-fixed transition-colors flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">download</span>
            Get Syllabus & Fee Details
          </a>
          <a href="#modules" class="px-6 py-4 bg-surface-container-high text-on-surface font-label-md uppercase tracking-widest rounded border border-outline-variant/30 hover:border-primary transition-colors">
            View Curriculum
          </a>
        </div>
      </div>
      
      <div class="relative h-[480px] lg:h-[520px] rounded-2xl overflow-hidden bg-surface-container shadow-2xl">
        <img fetchpriority="high" decoding="async" src="/images/academy-live/cosmetology_career_options.jpg" class="w-full h-full object-cover" alt="LivArt Job-Oriented Salon Training and Career Placement in Studio" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-8">
          <div class="inline-block px-3 py-1 bg-primary text-white text-xs uppercase tracking-widest font-bold rounded mb-2 w-max">
            Direct Employment
          </div>
          <h3 class="font-headline-sm text-white text-xl font-bold">Fast-Track Your Salon Career</h3>
          <p class="text-white/80 font-body-sm text-sm mt-1">Get certified in standard salon procedures and start working within 30 days.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MODULES: HAIR & SKIN (Page 12 of Prospectus) -->
  <section id="modules" class="py-space-xl px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto">
    <div class="max-w-3xl mb-space-xl text-center mx-auto">
      <span class="font-label-sm uppercase tracking-widest text-primary block mb-2 font-bold">Practical Curriculum</span>
      <h2 class="font-display-lg text-display-lg text-on-surface tracking-tight">Everything Salons Require on Day One.</h2>
      <p class="font-body-lg text-on-surface-variant mt-4">Focused 100% on high-frequency commercial salon services:</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter-lg">
      <!-- HAIR SECTION -->
      <div class="bg-surface-container-low p-space-lg rounded-2xl border border-outline-variant/20 shadow-xl">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/20">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
            <span class="material-symbols-outlined">content_cut</span>
          </div>
          <div>
            <span class="font-label-sm uppercase tracking-widest text-primary font-bold text-xs">Pillar 1</span>
            <h3 class="font-headline-sm text-2xl font-bold text-on-surface">Salon Hair Services</h3>
          </div>
        </div>

        <ul class="space-y-4 font-body-md text-on-surface-variant">
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Blow Dry & Setting:</strong> Mastery of round brush, paddle brush, volume styling and sleek finishes.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Shampoo, Hair Wash & Basin Etiquette:</strong> Correct basin posture, temperature control, and deep cleansing.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Towel Draping & Client Hygiene:</strong> Sterile salon drape setup, sanitation, and professional client manners.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Basic Haircuts:</strong> Straight cuts, U-cut, V-cut, and basic commercial layer trims.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Root Touch-Up & Quick Colouring:</strong> Rapid grey coverage, mixing ratios, and clean application without staining.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Traditional Oil Massage & Scalp Spa:</strong> Pressure points, circulation therapy, and steam mask protocols.</div>
          </li>
        </ul>
      </div>

      <!-- SKIN SECTION -->
      <div class="bg-surface-container-low p-space-lg rounded-2xl border border-outline-variant/20 shadow-xl">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-outline-variant/20">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
            <span class="material-symbols-outlined">spa</span>
          </div>
          <div>
            <span class="font-label-sm uppercase tracking-widest text-primary font-bold text-xs">Pillar 2</span>
            <h3 class="font-headline-sm text-2xl font-bold text-on-surface">Salon Skin Services</h3>
          </div>
        </div>

        <ul class="space-y-4 font-body-md text-on-surface-variant">
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Precision Threading:</strong> Eyebrow mapping, arch definition, upper lip, chin, and full-face threading.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Commercial Facials:</strong> Facial massage strokes, steaming, extraction, and clay/cream mask setting.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Salon Clean Up:</strong> Rapid 30-minute deep pore cleansing, blackhead extraction, and soothing toners.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Manicure Protocols:</strong> Cuticle care, filing, buffing, hand massage, and polish application.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Pedicure Protocols:</strong> Foot soaking, dead skin scrub, callus removal, and foot relaxation massage.</div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-sm mt-1">check_circle</span>
            <div><strong>Full Body Waxing:</strong> Arms, legs, underarms, and honey/strip waxing techniques with minimum pain.</div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SALON FLOOR SKILLS IN MOTION (REELS) -->
  <section class="py-space-xl bg-surface-container-lowest border-y border-outline-variant/20">
    <div class="max-w-[1440px] mx-auto px-margin-sm lg:px-margin-lg">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-space-lg gap-2">
        <div>
          <span class="font-label-sm text-primary uppercase tracking-widest text-xs font-bold block mb-1">Commercial Services</span>
          <h2 class="font-display-md text-2xl sm:text-3xl font-bold text-on-surface">Floor Procedures in Motion</h2>
        </div>
        <a 
          href="https://www.instagram.com/livart_academy/" 
          target="_blank" 
          class="text-xs text-primary font-bold uppercase tracking-wider hover:underline flex items-center gap-1.5"
        >
          <span>See More on @livart_academy</span>
          <span class="material-symbols-outlined text-sm">open_in_new</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <InstagramReelCard 
          url="https://www.instagram.com/livart_academy/"
          image="/images/academy-live/loreal_hair_spa_practical.jpg"
          category="Blow Dry Finish"
          title="L'Oréal Professional Practical Bay"
          description="High-volume salon blowout and keratin shine sealing demonstrated on live clients."
          badge="@livart_academy"
        />

        <InstagramReelCard 
          url="https://www.instagram.com/livart_academy/reel/DcIgaKVBb3R/"
          image="/images/academy-live/haircut_transformation_live.jpg"
          category="Haircut Floor"
          title="Professional Haircut & Grooming"
          description="Live model haircutting, sectioning, and styling execution inside our salon floor."
          badge="@livart_academy"
        />

        <InstagramReelCard 
          url="https://www.instagram.com/livart_academy/"
          image="/images/instagram/C88tG9iSEKp.jpg"
          category="Spa Services"
          title="Deluxe Pedicure & Foot Spa Therapy"
          description="Essential salon foot care, exfoliating scrub, and relaxing massage protocols."
          badge="@livart_academy"
        />
      </div>
    </div>
  </section>

  <!-- LEAD CAPTURE SECTION -->
  <section id="enroll" class="py-space-xl px-margin-sm lg:px-margin-lg max-w-[900px] mx-auto scroll-mt-20">
    <CourseLeadForm 
      courseName="Job-Oriented Salon Course (1 Month)"
      title="Request Salon Course Syllabus & Fee Structure"
      subtitle="Fill in your details below to receive the complete 1-Month Job-Oriented Salon Course syllabus, batch timings, and fee schedule via WhatsApp."
      formId="salon-job-lead-form"
    />
  </section>

  <!-- COURSE SCHEMA MARKUP -->
  <script type="application/ld+json" set:html={`
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "Job-Oriented Salon Course (1 Month)",
      "description": "Accelerated 1-month job-oriented salon course in Kochi covering blow dry, haircuts, facials, root touch-up, manicure, pedicure, and threading at Livart Beauty Academy.",
      "provider": {
        "@type": "EducationalOrganization",
        "name": "Livart Beauty Academy",
        "url": "https://livart.co.in",
        "sameAs": "https://livart.co.in"
      }
    }
  `} />
</Layout>
