---
import Layout from '../../layouts/Layout.astro';
import CourseLeadForm from '../../components/CourseLeadForm.astro';
import InstagramReelCard from '../../components/InstagramReelCard.astro';
import CoursePrintButton from '../../components/CoursePrintButton.astro';
import CoursePrintProspectus from '../../components/CoursePrintProspectus.astro';

const bridalModules = [
  { num: "01", title: "Fundamentals & Skin Preparation", desc: "Personal grooming • History & introduction to bridal makeup • Skin types & preparation • High-performance bridal product knowledge." },
  { num: "02", title: "Colour Theory & Base Makeup", desc: "Colour correction & dark circle concealing • Colour wheel & theory • Foundation mixing for perfect bridal skin matching." },
  { num: "03", title: "Cream Contouring & Face Definition", desc: "Cream contour sculpting • Cream blush application • Strategic high-glow bridal highlighter application." },
  { num: "04", title: "Long-Wear Lip Makeup", desc: "Lip contouring • Sweat-resistant lipstick application • High-shine lip gloss techniques." },
  { num: "05", title: "Eyebrow & Eye Makeup Artistry", desc: "Eyebrow shaping & filling • 1, 2 & 3-shade eye makeup • Shimmer eye • Smokey eye • Kajal • Waterproof eyeliner • Mascara." },
  { num: "06", title: "Powder Setting & Fixing", desc: "Bridal baking & powder setting • Professional fixing sprays • Sweatproof & tearproof sealing techniques." },
  { num: "07", title: "Hair Preparation & Products", desc: "Bridal hair prep • Thermal protectants & styling mousses • Blow-drying techniques for lasting volume." },
  { num: "08", title: "Thermal Hair Styling Techniques", desc: "Micro-crimping for volume • Tong curling • Sleek straightening • Strategic backcombing for bridal crowns." },
  { num: "09", title: "Bridal Hairstyle Creation", desc: "Textured braid variations • South & North Indian bun setting • Ponytail styling • Flower setting • Front variations (French, Duck, Twist)." },
  { num: "10", title: "Saree Draping & Pleating Mastery", desc: "Pre-pleating & steam ironing • Box folding • Draping for lean, medium & heavy silhouettes • Side & hip pleats • Fluffy pleats • Movement draping • Lehenga draping." },
  { num: "11", title: "Three Bridal Culture Demos", desc: "Traditional Hindu bridal look • Elegant Christian bridal look • Royal Muslim bridal look demonstrations by master educators." },
  { num: "12", title: "Client Consultation & Complete Look", desc: "Bride consultation & trial etiquette • Bridal makeup timing • Saree draping • Complete head-to-toe bridal look demonstration." },
  { num: "13", title: "Practical Examination & Final Model", desc: "Exam preparation & intensive timed practice • Practical bridal evaluation • Full look execution on a final live model." }
];
---

<Layout 
  title="Fastrack Bridal Makeup Course (10 Days) | Livart Beauty Academy Kochi"
  description="Master high-earning Hindu, Christian, and Muslim bridal looks in 10 intensive days at Livart Beauty Academy Kochi. Includes hairstyling, saree draping, brush kit, and live model practical exam."
>
  <div class="screen-only">
    <!-- HERO -->
    <section class="relative pt-24 pb-16 px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto border-b border-outline-variant/20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter-lg items-center">
        <div>
          <div class="inline-flex items-center gap-space-xs px-3 py-1 rounded-full bg-primary/10 border border-primary/20 mb-6">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            <span class="font-label-sm uppercase tracking-widest text-primary text-xs font-bold">Fast-Track Intensive • 2026 Admissions Open</span>
          </div>
          <h1 class="font-display-lg text-display-lg lg:text-[60px] lg:leading-[68px] text-on-surface tracking-tight mb-6">
            Fastrack <span class="italic text-primary">Bridal Makeup.</span>
          </h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl leading-relaxed mb-8">
            The most lucrative 10-day bridal bootcamp in Kerala. Master Hindu, Christian, and Muslim wedding looks, thermal hairstyles, saree pre-pleating, and complete your final evaluation on a live model.
          </p>
          
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8 border-y border-outline-variant/20 py-6">
            <div>
              <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Duration</span>
              <strong class="font-title-md text-on-surface text-base">10 Days</strong>
            </div>
            <div>
              <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Tool Kit</span>
              <strong class="font-title-md text-on-surface text-base">Brush Kit Included</strong>
            </div>
            <div>
              <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Wedding Cultures</span>
              <strong class="font-title-md text-on-surface text-base">Hindu, Christian, Muslim</strong>
            </div>
            <div>
              <span class="block font-label-sm uppercase text-outline mb-1 text-xs">Final Evaluation</span>
              <strong class="font-title-md text-on-surface text-base">Live Model Exam</strong>
            </div>
          </div>

          <div class="flex flex-wrap gap-4 items-center">
            <a href="#enroll" class="px-8 py-4 bg-primary text-on-primary font-label-md uppercase tracking-widest font-bold rounded shadow-lg hover:bg-primary-fixed transition-colors flex items-center gap-2">
              <span class="material-symbols-outlined text-lg">download</span>
              Get Syllabus & Fee Details
            </a>
            <a href="#curriculum" class="px-6 py-4 bg-surface-container-high text-on-surface font-label-md uppercase tracking-widest rounded border border-outline-variant/30 hover:border-primary transition-colors">
              View 13 Modules
            </a>
            <CoursePrintButton label="Print Course Details" />
          </div>
        </div>
        
        <div class="relative h-[480px] lg:h-[520px] rounded-2xl overflow-hidden bg-surface-container shadow-2xl">
          <img fetchpriority="high" decoding="async" src="/images/academy-live/bridal_couture_transformation.jpg" class="w-full h-full object-cover object-[center_20%]" alt="LivArt Bridal Makeup Artistry and Muhurtham Transformation" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent flex flex-col justify-end p-8">
            <div class="inline-block px-3 py-1 bg-primary text-white text-xs uppercase tracking-widest font-bold rounded mb-2 w-max">
              Complete Bridal Package
            </div>
            <h3 class="font-headline-sm text-white text-xl font-bold">Makeup + Hairstyling + Saree Draping</h3>
            <p class="text-white/80 font-body-sm text-sm mt-1">Concludes with a formal practical examination on your own model.</p>
          </div>
        </div>
      </div>
    </section>

  <!-- 13 MODULES BREAKDOWN (Page 11 of Prospectus) -->
  <section id="curriculum" class="py-space-xl bg-surface-container-lowest border-y border-outline-variant/20">
    <div class="max-w-[1440px] mx-auto px-margin-sm lg:px-margin-lg">
      <div class="max-w-3xl mb-space-xl">
        <span class="font-label-sm uppercase tracking-widest text-primary block mb-2 font-bold">10-Day Accelerated Structure</span>
        <h2 class="font-display-lg text-display-lg text-on-surface tracking-tight">Fastrack Bridal Makeup Modules.</h2>
        <p class="font-body-lg text-on-surface-variant mt-4">A high-velocity curriculum covering every single technical step required to deliver high-value luxury bridal bookings with confidence.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {bridalModules.map(m => (
          <div class="bg-surface-container-low p-6 rounded-xl border border-outline-variant/15 hover:border-primary/40 transition-colors flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="font-label-sm text-primary uppercase tracking-widest font-bold text-xs">Module {m.num}</span>
              </div>
              <h3 class="font-headline-sm text-lg font-bold text-on-surface mb-2">{m.title}</h3>
              <p class="font-body-sm text-on-surface-variant text-sm leading-relaxed">{m.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HIGHLIGHTS / TOOL KIT -->
  <section class="py-space-xl px-margin-sm lg:px-margin-lg max-w-[1440px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 bg-surface-container-low rounded-xl border border-outline-variant/15">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary mb-4">
          <span class="material-symbols-outlined">brush</span>
        </div>
        <h4 class="font-headline-sm text-lg font-bold text-on-surface mb-2">Professional Brush Kit Included</h4>
        <p class="font-body-sm text-on-surface-variant leading-relaxed">
          Every student receives an individual professional makeup brush kit to use throughout the 10 days and take into professional practice.
        </p>
      </div>

      <div class="p-6 bg-surface-container-low rounded-xl border border-outline-variant/15">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary mb-4">
          <span class="material-symbols-outlined">dry_cleaning</span>
        </div>
        <h4 class="font-headline-sm text-lg font-bold text-on-surface mb-2">Saree Draping & Pre-Pleating</h4>
        <p class="font-body-sm text-on-surface-variant leading-relaxed">
          Master box-folding, steam iron pre-pleating, hip pleats, and movement draping so brides can walk comfortably and look immaculate.
        </p>
      </div>

      <div class="p-6 bg-surface-container-low rounded-xl border border-outline-variant/15">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary mb-4">
          <span class="material-symbols-outlined">person_celebrating</span>
        </div>
        <h4 class="font-headline-sm text-lg font-bold text-on-surface mb-2">Final Live Model Examination</h4>
        <p class="font-body-sm text-on-surface-variant leading-relaxed">
          Culminates on Day 10 with a timed bridal transformation on a live model, evaluated by Stephy Sebastian and senior educators.
        </p>
      </div>
    </div>
  </section>

  <!-- BRIDAL WORK IN MOTION (REELS) -->
  <section class="py-space-xl bg-surface-container-lowest border-y border-outline-variant/20">
    <div class="max-w-[1440px] mx-auto px-margin-sm lg:px-margin-lg">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-space-lg gap-2">
        <div>
          <span class="font-label-sm text-primary uppercase tracking-widest text-xs font-bold block mb-1">Student Outcomes in Motion</span>
          <h2 class="font-display-md text-2xl sm:text-3xl font-bold text-on-surface">Live Bridal Transformations</h2>
        </div>
        <a 
          href="https://www.instagram.com/livart_academy/" 
          target="_blank" 
          class="text-xs text-primary font-bold uppercase tracking-wider hover:underline flex items-center gap-1.5"
        >
          <span>Watch Daily on Instagram</span>
          <span class="material-symbols-outlined text-sm">open_in_new</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <InstagramReelCard 
          url="https://www.instagram.com/reel/Cj9gISlIba1/"
          image="/images/academy-live/ig_student_testimonial_nimmy.jpg"
          category="Student Journey"
          title="Student Nimmy Kalathil — Bridal Artistry"
          description="From foundation basics to mastering complete bridal makeovers and client drapery in Kalamassery."
          badge="@livart_academy Reel"
        />

        <InstagramReelCard 
          url="https://www.instagram.com/livart_academy/"
          image="/images/academy-live/bridal_masterclass_pathadipalam.jpg"
          category="Muhurtham Look"
          title="Traditional Hindu Bridal Masterclass"
          description="South Indian bridal makeover with 4K sweatproof HD base, temple jewelry framing, and kasavu styling."
          badge="Live Studio Bay"
        />

        <InstagramReelCard 
          url="https://www.instagram.com/livart_academy/"
          image="/images/academy-live/saree_draping_masterclass.jpg"
          category="Draping Mastery"
          title="Crisp Pleats & Veil Architecture"
          description="Mastering iron-pressed pleats, secure pin placement, and royal veil draping essential for brides."
          badge="Masterclass"
        />
      </div>
    </div>
  </section>

  <!-- LEAD CAPTURE SECTION -->
  <section id="enroll" class="py-space-xl px-margin-sm lg:px-margin-lg max-w-[900px] mx-auto scroll-mt-20">
    <CourseLeadForm 
      courseName="Fastrack Bridal Makeup (10 Days)"
      title="Request Bridal Course Syllabus & Fee Structure"
      subtitle="Fill in your details below to receive the complete 10-Day Fastrack Bridal prospectus, kit details, upcoming batch dates, and fee schedule via WhatsApp."
      formId="bridal-lead-form"
    />
  </section>
  </div> <!-- /screen-only -->

  <!-- EXECUTIVE PRINT PROSPECTUS (VISIBLE ONLY WHEN PRINTED / SAVED AS PDF) -->
  <CoursePrintProspectus
    courseTitle="Fastrack Bridal Makeup Course (10 Days)"
    courseSubtitle="Intensive luxury bridal bootcamp covering Hindu, Christian & Muslim wedding looks, 4K HD complexion base, thermal hair styling, saree pre-pleating, and final live model practical evaluation."
    duration="10 Days (High-Intensity Daily Sessions)"
    eligibility="Open for 10th, 12th, Graduates & Beauty Aspirants • No Prior Experience Required"
    certification="LivArt Master Bridal Certification & B&WSSC Aligned"
    toolKit="Professional Brush Set & Makeup Tools Included"
    trainingFormat="100% Practical Training on Live Models in Kalamassery Bridal Bays"
    batchCapacity="Strictly 8–10 Students per Batch for Individual Mentorship"
    internship="Live Model Practical Evaluation & 100% Bridal Placement Guidance"
    modules={bridalModules}
    careerOutcomes={[
      "Independent Luxury Bridal Makeup Artist",
      "Destination Wedding Makeup & Saree Pleating Stylist",
      "Celebrity Bridal & Fashion Media Artist",
      "Freelance Bridal Studio Entrepreneur"
    ]}
  />

  <!-- COURSE SCHEMA MARKUP -->
  <script type="application/ld+json" set:html={`
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "Fastrack Bridal Makeup Course (10 Days)",
      "description": "Intensive 10-day bridal makeup bootcamp in Kochi covering Hindu, Christian, and Muslim wedding looks, thermal hairstyles, saree draping, and live model practical exam at Livart Beauty Academy.",
      "provider": {
        "@type": "EducationalOrganization",
        "name": "Livart Beauty Academy",
        "url": "https://livart.co.in",
        "sameAs": "https://livart.co.in"
      }
    }
  `} />
</Layout>
